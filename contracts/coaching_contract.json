  "pricing": {
    "finalFormula": "(coachPriceEgp * 115 + 50) // 100",
    "vectorsFile": "contracts/coaching_price_vectors.json",
    "refundFormula": "priceFinalEgp - (priceFinalEgp * sessionsUsed) // sessionsIncluded",
    "coachShareAfterRefund": "(coachPriceEgp * sessionsUsed) // sessionsIncluded",
    "sessionsIncluded": "liveSessionsPerMonth * durationDays // 28",
    "monthlyEquivalent": "priceFinalEgp * 28 // durationDays"
  },
