    "maxActiveClientsMax": 50,
    "requestAnswerHours": 72,
    "payByHours": 72,
    "proofAttempts": 3,
    "proofLongSidePx": 1600,
    "proofMaxBytes": 8000000,
    "nearImageHamming": 6,
    "nearImageWindow": 1000,
    "proofImageAlertDays": 7,
    "cancelWindowDays": 14,
    "payoutEligibleDays": 14,
    "refundWithinDays": 7,
    "endsSoonDays": 3,
    "messageMaxChars": 2000,
    "messagePageSize": 50,
    "pushThrottleMinutes": 3,
    "planMaxDays": 7,
