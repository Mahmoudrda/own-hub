  "triggers": {
    "on_coaching_message": "relationships/{relId}/messages/{messageId} created: screen the text, hide it when the screen fails, set lastMessageAt, lastMessage and the other party's unreadFor, push the other party at most once per pushThrottleMinutes",
    "coaching_sweeper": "every 1 hours: expire requests, end finished ones and send the endsSoon push (clients switch); expire unpaid subscriptions, ledger pending to eligible and alert on proof images older than proofImageAlertDays (payments switch); retry missed coach claims always"
  },
