    "request_coaching": {
      "who": "verified member, not blocked either way, coach published and accepting",
      "module": "coaching.subscriptions.request",
      "requestKeys": [
        "coachUid",
        "packageId",
        "intake",
        "locale",
        "clientName"
      ],
      "responseKeys": [
        "subId",
        "status"
      ],
      "note": "No price travels in the request. Auto-accept moves straight to awaiting_payment when the coach has autoAccept on, is under maxActiveClients and no health answer is yes."
    },
    "respond_coaching_request": {
      "who": "coach, her own request",
      "module": "coaching.subscriptions.respond",
      "requestKeys": [
        "subId",
        "decision",
        "reason"
      ],
      "responseKeys": [
        "status"
      ]
    },
    "end_my_coaching": {
      "who": "the client or the coach of the subscription",
      "module": "coaching.subscriptions.end_mine",
      "requestKeys": [
        "subId",
        "reason"
      ],
      "responseKeys": [
        "status"
      ],
      "note": "Clients switch. reason is optional text, checked and not kept. requested becomes cancelled; awaiting_payment and active become ended_early with endReason client_left or coach_left (active also closes the chat, frees the place and adds the ended line). payment_review and a requested cancellation are refused wrong_status. The other party is pushed coachingEnded. A block between the two ends any open coaching the same way with endReason safety and no push; plan, session and request calls then refuse coach_unavailable."
    },
    "cancel_coaching_request": {
      "who": "the client, before payment_review",
