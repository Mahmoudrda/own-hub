  "reasonNotes": {
    "coach_unavailable": "One reason for every case where she cannot request this coach: not published, not accepting, full, or a block either way. A block is never signalled.",
    "wrong_status": "The subscription, proof or session is not in a status that allows this call. Refresh and try again.",
    "reference_used": "That transfer reference is already attached to another payment.",
    "staff_is_subject": "Staff cannot decide their own application, payment, refund, payout or report."
  }
