        "servings": "0.25..6",
        "grams": "1..2000",
        "text": "<= 80 chars, free only",
        "note": "<= 120 chars"
      },
      "rule": "No nutrition figures in the body. The phone computes them from the verified food pack and recipe library."
    }
  },
  "callables": {
    "submit_coach_application": {
