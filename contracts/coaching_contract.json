    "coachPriceMinEgp": 200,
    "coachPriceMaxEgp": 30000,
    "marginPercent": 15,
    "maxPackages": 6,
    "durationDays": [
      28,
      56,
      84
    ],
    "liveSessionsPerMonthMin": 2,
    "liveSessionsPerMonthMax": 12,
    "sessionMinutes": [
      30,
      45,
      60
    ],
    "checkInsPerWeekMax": 7,
    "includesMax": 8,
    "includeTextMax": 80,
    "packageTitleMax": 60,
    "packageDescriptionMax": 600,
    "maxActiveClientsDefault": 15,
