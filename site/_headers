# Own Hub — security headers for a static site with no scripts.
# form-action: the waitlist form posts to the join_waitlist Cloud Function,
# which answers with a redirect back to this site ('self'). Nowhere else.
# Netlify and Cloudflare Pages read this file. On another host, translate the
# same rules into its own configuration: the Content-Security-Policy is the
# one that matters, because it is what makes "this page phones nobody" a rule
# the browser enforces rather than a claim on the page.

/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'self' https://europe-west3-own-hub.cloudfunctions.net; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()

# The typeface never changes under these names, so it can be cached hard.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/favicon.svg
  Cache-Control: public, max-age=604800

# The stylesheet does change. A week, revalidated.
/assets/site.css
  Cache-Control: public, max-age=3600, must-revalidate

# The generator and its templates. They should not be served at all — the
# _redirects file turns them into a 404 — but if a host ignores that, at least
# keep them out of the index.
/_build/*
  X-Robots-Tag: noindex, nofollow
