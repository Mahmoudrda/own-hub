{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": [
    {
      "bucket": "own-hub-personal",
      "rules": "firebase/storage.rules"
    },
    {
      "bucket": "own-hub.firebasestorage.app",
      "rules": "firebase/storage.library.rules"
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "identity",
      "runtime": "python312",
      "ignore": [
        ".venv",
        "venv",
        "__pycache__",
        "*.pyc",
        ".pytest_cache",
        "tests",
        "tools"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
