<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- teamID is not a secret; it is safe to commit. Replace YOUR_TEAM_ID with
	     the Team ID from developer.apple.com > Membership. tool/release_preflight.sh
	     fails while the placeholder is still here. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>YOUR_TEAM_ID</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
