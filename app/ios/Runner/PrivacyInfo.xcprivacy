<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Own Hub privacy manifest.

	  WHAT THIS BINARY DOES TODAY. `Firebase.initializeApp` runs on every launch
	  (`lib/app_state/firebase_boot.dart`), and pubspec carries six Firebase
	  packages: firebase_core, firebase_auth, cloud_firestore, firebase_storage,
	  cloud_functions, firebase_app_check and firebase_crashlytics. Firebase mints an installation identifier and sends it
	  with every call it makes, so the app collects a device identifier whether
	  or not a woman ever signs in. Apple's category for that is DeviceID, and it
	  is declared below.

	  DeviceID is not linked and not tracking: there are no ad SDKs, no
	  analytics SDK and no third party it is shared with. NSPrivacyTracking
	  stays false.

	  THE ACCOUNT BUILD. Sign-up and identity verification ship at launch, so
	  the data an account collects is declared here, all LINKED (to her
	  account), none tracking, purpose AppFunctionality:
	    - PhoneNumber: sign-in by SMS code (Firebase Authentication).
	    - UserID: the Firebase uid her account and documents are keyed by.
	    - HealthFitness: workouts and meals sync for a verified account; her
	      cycle, period dates, check-ins, measurements, life stage and
	      allergies only if she turns on "Back up my health data" (off by
	      default, its own consent). Apple treats menstrual data as sensitive
	      health data, and the App Store Connect answers must match.
	    - OtherUserContent: both sides of her national ID card and one selfie,
	      sent to our own check and discarded. Never stored. "Deleted
	      afterwards" is not an exemption from declaring them.
	    - OtherDataTypes: the national ID number read from the card; only a
	      keyed one-way hash of it is kept, to stop one card being used twice.
	  CrashData: Firebase Crashlytics, release builds only. NOT linked: the app
	  never sets a user identifier, a custom key or a log line (a source guard
	  test enforces that), so a crash report carries the stack trace and the
	  device and OS, not her account. Not tracking. Purpose AppFunctionality.
	  SensitiveInfo only if counsel asks for it.

	  NSPrivacyAccessedAPITypes is empty for the APP TARGET only. Every
	  required-reason API this product touches is touched by a package that ships
	  its own manifest, which Xcode merges into the privacy report at build time:
	  shared_preferences declares NSUserDefaults CA92.1, and the Google and MLKit
	  pods declare disk space, file timestamp, boot time and user defaults. If
	  the app target ever reads one of those APIs directly, it belongs here.

	  This file, the App Privacy answers in App Store Connect and
	  the published privacy policy must say the same thing. A mismatch between
	  the three is one of the most common rejections. Verify with Xcode:
	  Product > Archive > Organizer > Generate Privacy Report.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhoneNumber</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeHealthFitness</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
