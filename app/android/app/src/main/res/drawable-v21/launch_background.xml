<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by the window until Flutter draws its first frame. The same pale
     surface the app paints first, with the brand tile, so the start is one
     picture instead of a white flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
