<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The only permission this app asks for, and the only one it needs.
         Android shows its own sentence on the runtime prompt and gives us no
         string to put in it, so the explanation lives on the consent screen
         that runs immediately before the camera opens, in Arabic and English.
         iOS is the platform that lets us write the sheet copy, and we do, in
         ios/Runner/{en,ar}.lproj/InfoPlist.strings. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- DELIBERATELY ABSENT: READ_MEDIA_IMAGES, READ_EXTERNAL_STORAGE and
         anything else that reaches the photo library. She photographs her card
         live, now. A flow that could pick an existing picture could pick a
         picture of somebody else's card, which is the entire attack the
         women-only gate has to survive. It is also a Play Data Safety
         declaration and a policy conversation we would have to have for a
         capability the product does not want. -->

    <!-- Not required, so the app still installs on a handset with no camera or
         no autofocus. Google Play filters installs on any hardware feature a
         manifest requests without saying otherwise, and a woman whose phone
         cannot do the check can still train, cook and read; only the community
         waits for her. C10 tells her the camera is missing and offers the
         woman-reviewer path. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:label="Own Hub"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
