<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The only permission this app asks for, and the only one it needs.
         Android shows its own sentence on the runtime prompt and gives us no
         string to put in it, so the explanation lives on the consent screen
         that runs immediately before the camera opens, in Arabic and English.
         iOS is the platform that lets us write the sheet copy, and we do, in
         ios/Runner/{en,ar}.lproj/InfoPlist.strings. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- DELIBERATELY ABSENT: READ_MEDIA_IMAGES, READ_EXTERNAL_STORAGE and
         anything else that reaches the photo library. She photographs her card
         live, now. A flow that could pick an existing picture could pick a
         picture of somebody else's card, which is the entire attack the
         women-only gate has to survive. It is also a Play Data Safety
         declaration and a policy conversation we would have to have for a
         capability the product does not want. -->

    <!-- Stripped from the MERGED manifest, because plugins add them. The
         camera plugin declares RECORD_AUDIO for video, and this app records no
         sound (enableAudio is false in camera_capture_service.dart); a library
         can also bring READ_EXTERNAL_STORAGE. Neither may reach a store build:
         each is a Data safety declaration for a capability we do not use.
         WRITE_EXTERNAL_STORAGE goes too: camerax writes only to the app's
         cache. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- One push: "your check is done", when a woman reviewer approves her.
         Firebase Cloud Messaging brings the c2dm RECEIVE permission it needs
         to deliver it, so that one is no longer stripped. Android 13 and
         later ask her for POST_NOTIFICATIONS, and only when she taps "Tell me
         when I'm in" on C14, never at launch. Declared as a device ID (the
         push token) in android/play-data-safety.txt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Training reminders: on the days she chose on R10 or in Notifications,
         scheduled on the phone (flutter_local_notifications). The phone
         forgets scheduled alarms when it restarts; this lets the app set them
         again. Inexact on purpose: no exact-alarm permission is requested. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- No advertising ID. The analytics SDK's library manifest brings this
         permission; Own Hub shows no advertising and never reads the ID
         (google_analytics_adid_collection_enabled is false below), so it is
         stripped from the merged manifest and "Advertising ID" is not a
         Data safety answer. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <!-- The same SDK also asks for Android's Privacy Sandbox ad services
         (advertising ID, ad attribution, ad topics). None is used, so they
         are stripped too. -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />

    <!-- Not required, so the app still installs on a handset with no camera or
         no autofocus. Google Play filters installs on any hardware feature a
         manifest requests without saying otherwise, and a woman whose phone
         cannot do the check can still train, cook and read; only the community
         waits for her. C10 tells her the camera is missing and offers the
         woman-reviewer path. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- No Android backup and no device-to-device transfer. Her data is
         local-first, and moving it to a new phone is the Own Hub backup she
         turns on herself. A restored copy would also carry this phone's
         memory that she was verified onto a phone that never proved it.
         tools:replace keeps a library from turning backup back on. -->
    <application
        android:label="Own Hub"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Crash reporting is off until Dart turns it on, and Dart turns it
             on only in a release build (lib/app_state/firebase_boot.dart). So
             a debug run never sends a crash report, not even one from
             before Flutter starts. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <!-- Usage statistics ("Help improve Own Hub") are off until she turns
             them on in C06 or Privacy (lib/app_state/firebase_boot.dart).
             Consent mode v2 defaults: every storage denied; advertising
             storage, ad user data and ad personalisation are never granted.
             No advertising ID, and no automatic screen views: the router
             logs screen ids itself. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_analytics_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />
        <!-- The status-bar icon for "your check is done" and for her training
             reminders: a white silhouette, as Android requires. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_ownhub" />
        <!-- Training reminders, scheduled on the phone, and set again after
             a restart or an update. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- "Ask for a copy" in Your data opens an email to the privacy
             mailbox. Declared so a mail app is visible on Android 11 and up. -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>
