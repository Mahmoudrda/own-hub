rules_version = '2';

// Own Hub — Firestore security rules.
//
// READ THIS BEFORE EDITING.
//
// Firestore evaluates overlapping match statements so that access is allowed if
// ANY matching condition is true. There is no deny, and a more specific rule
// CANNOT revoke what a broader one granted. That single fact shapes this whole
// file: if each feature group wrote its own `match /users/{uid}`, one permissive
// `allow update` anywhere would defeat every sibling restriction — including the
// server-only guard on verification, which is the line that makes this a
// women-only product.
//
// Therefore:
//   * there is exactly ONE `match /users/{uid}` block and ONE for
//     `match /coaches/{coachUid}` in this file, and a test asserts that;
//   * per-group field permissions are OR-ed together inside those blocks;
//   * the global invariants are AND-ed OUTSIDE the OR, so no slice can escape
//     them, no matter what a future group adds to its own slice.
//
// Adding a second match block for either root re-opens the hazard. Extend the
// slice instead.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // N1. Email/password, Google and Apple sign-in are enabled in the
    // console, so an account with no SMS step behind it can exist. Her own
    // data may be created or updated only by a phone sign-in. Reads and
    // deletes do not ask for it: export and erasure belong to every account.
    function phoneUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'phone';
    }

    // Verification is a server-minted custom claim, never a document read. A
    // rules get() here would bill one extra read on every gated operation.
    function isVerified() {
      return signedIn() && request.auth.token.verified == true;
    }

    function isCoach() {
      return signedIn() && request.auth.token.coachV == 'active';
    }

    // THE WHOLE-APP GATE, and the four paths that must escape it.
    //
    // Spec §1: she cannot USE the app before verification completes. Spec §5
    // states it as "deny all app data reads and writes unless verified".
    //
    // Applied literally to EVERYTHING, that is a deadlock. The verification
    // flow itself writes `users/{uid}`; if that write needs the `verified`
    // claim, she can never earn the claim, because earning it requires the
    // write. Sign-up bricks for every new account, including the owner's, and
    // it bricks silently — a permission denial on the first screen after
    // sign-up looks like a network problem.
    //
    // So the gate has a named set of exceptions. DO NOT "tidy" this into a
    // uniform gate. The deadlock is not visible from outside and it cannot be
    // caught by reading the rule that causes it.
    //
    // Behind the gate: her logs, her body data, her plans, the community, the
    // coaching surfaces, the content library. Everything the product IS.
    //
    // NOT behind the gate, and why each one. This list was wrong: an evaluator
    // run found ELEVEN more paths an unverified account could reach than the
    // list named. Each has since been decided one way or the other, and the
    // decision is recorded here rather than left to be rediscovered.
    //
    //   * `users/{uid}` itself — the deadlock path above. Written by the
    //     sign-up screen before verification and read by the verification flow.
    //     It is already locked down field by field: `verificationUntouched()`
    //     means she can never write her own verification result, which is the
    //     property that actually matters here.
    //   * `consents` — she consents BEFORE the camera opens (spec §2 step 1),
    //     so a gate here would make consent impossible to give, and PDPL gives
    //     her a right of access to her own consent records regardless.
    //   * `deletionRequests` — a woman who was never verified must still be
    //     able to leave, and to watch her erasure run. A right to erasure that
    //     depends on passing a face match is not a right.
    //   * `blocks`, `blockedBy`, `myReports`, and `reports` creation — safety
    //     must never depend on a verification state. A woman being harassed
    //     during sign-up needs to block and report him before anyone checks
    //     her ID.
    //   * `devices` — the push token is registered at launch, before the
    //     camera opens, and the verification RESULT is delivered to it. A gate
    //     here means the one notification she is waiting for has nowhere to
    //     land. It now carries a key whitelist and the global invariants, so
    //     the exception is a named door rather than an open collection.
    //   * `notifications` read and update — the same reason, from the other
    //     end: this inbox is where "your verification was approved" arrives.
    //     `create` and `delete` are `false`, so the only client powers here are
    //     reading her own and marking one read.
    //   * `followGraph` DELETE — unfollowing must never be gated, for the same
    //     reason it is exempt from `notBlockedBy()`: a lapsed claim must not
    //     trap a follow edge forever. `create` and `update` ARE gated.
    //   * `posts` and `comments` delete, own only — taking her own words or her
    //     own photograph down is an act of the same family as blocking and
    //     reporting. It must not depend on a claim she might lose.
    //
    // MOVED BEHIND THE GATE after the same run, because none of them had a
    // reason to be outside it:
    //
    //   * `relationships` create — this was the escalation vector. See the
    //     block itself.
    //   * `notices` — `quietWeek` and `tierSlip` are both post-verification
    //     surfaces, so an unverified account had nothing to acknowledge.
    //   * `groups/{g}/members` write — joining a group is using the community.
    //   * `followGraph` create and update — so is following someone.
    //
    // The ephemeral liveness session state needs no exception: it is
    // server-only already (`verificationSessions`, below).
    //
    // RELEASE ORDERING: the client-side `accountRequired` flag that makes this
    // gate user-visible is the LAST change in this programme, not an early one.
    // Until the backend can actually approve a woman, turning it on locks out
    // every existing user including the owner.
    function isSelfVerified(uid) {
      return isSelf(uid) && isVerified();
    }

    // THE TWO DORMANT FEATURES, SWITCHED OFF HERE TOO (APL-16).
    //
    // The community and the coach app ship off in the app (`Feature.community`,
    // `Feature.coachApp`), and the privacy policy describes no feature that
    // connects members. Off in the app was not off on the server: a verified
    // account could write posts, comments, coach pages, relationships and
    // messages straight to the API, unmoderated. Every create and update on
    // those paths is AND-ed with one of these two, so the server refuses what
    // the app does not offer. Deleting her own post or leaving stays open:
    // taking something down never depends on a feature being live.
    //
    // Each moves with its app flag, with storage.rules' functions of the same
    // name and, for the coach app, with functions/coaching COACH_APP_LIVE. All
    // of them change in the same release, and deletion rows 45 to 49 already
    // cover what they open.
    function communityLive() {
      return false;
    }

    function coachLive() {
      return false;
    }

    // DECISIONS.md D12. Staff, for the content console — a server-minted claim
    // exactly like `verified` and `coachV`, so a client cannot grant itself
    // admin any more than it can grant itself a verified badge. This gates
    // WRITES to the content library only; it opens no door to users/{uid}.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // S17 / PDPL Art. 12. Her separate consent to back up health data, written
    // only by the record_health_consent callable. Cycle, period, check-in and
    // measurement writes, and the lifeStage and allergies profile keys, are
    // refused without it. Deletes never need it: withdrawing must always be
    // able to remove what is there. Two billed reads on those writes only.
    function hasHealthConsent(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/consents/health-v1)
        && get(/databases/$(database)/documents/users/$(uid)/consents/health-v1).data.state == 'granted';
    }

    // S17: the profile may carry lifeStage or allergies only with that consent.
    function profileHealthOk(uid) {
      return !touches(['profile'])
        || !request.resource.data.profile.keys().hasAny(['lifeStage', 'allergies'])
        || hasHealthConsent(uid);
    }

    // The set of keys this write touches.
    //
    // **`resource` is null on a create.** Firestore's own field-level guide
    // splits its two examples for exactly this reason: it uses
    // `request.resource.data.keys().hasOnly(...)` for create and
    // `request.resource.data.diff(resource.data).affectedKeys().hasOnly(...)`
    // for update, because on a create there is no existing document to diff
    // against. Reading `resource.data` there is an error, and an error in a
    // rule denies the request.
    //
    // This function had only the update half, and it is AND-ed into
    // `clientInvariants()`, which `allow create` on users/{uid} depends on. So
    // creating a user document — the first write this app ever makes, on the
    // first screen after sign-up — could never evaluate true. Nothing caught
    // it because no emulator runs in this project (no firebase.json, no Java
    // runtime), so the rules have never actually been executed.
    //
    // On a create, "the keys this write touches" is every key in the new
    // document, which is the correct reading and makes the invariants below
    // bite on create as well as update: a document born with a `verification`
    // map is now refused, not merely one that grows one later.
    function changed() {
      return resource == null
        ? request.resource.data.keys().toSet()
        : request.resource.data.diff(resource.data).affectedKeys();
    }

    function touches(fields) {
      return changed().hasAny(fields);
    }

    function onlyTouches(fields) {
      return changed().hasOnly(fields);
    }

    // A timestamp the client cannot backdate or postdate. Used where the value
    // starts a clock the product relies on — G7's one-hour report window is the
    // case that matters, because a forgeable createdAt is a forgeable deadline.
    function serverStamped(field) {
      return request.resource.data[field] == request.time;
    }

    // Spine K3, the G8 convention. `updatedAt` must come from the server's own
    // clock: a client that can backdate a write can lose someone else's edit in
    // a merge, and one that can postdate it can pin itself at the top of a range
    // query forever.
    //
    // G13 §6 and G14 §6 define this identically and G9 §6 calls it — but it was
    // never merged into this file, so every block written against it would have
    // been rejected at deploy time with an undefined-function error.
    function freshStamp() {
      return request.resource.data.updatedAt == request.time;
    }

    // freshStamp() only where `updatedAt` is actually written.
    //
    // freshStamp() itself cannot be AND-ed onto a collection whose client
    // writes are partial. On an UPDATE, `request.resource.data` is the whole
    // post-write document, so a write that never mentions `updatedAt` still
    // carries the stored value — and a bare freshStamp() would reject it for
    // not being `request.time`. On a CREATE, several collections legitimately
    // carry no clock at all (`checkins`, `firstWeek`, `splits`).
    //
    // So the rule is conditional on the key being TOUCHED, which is the honest
    // statement of the property anyway: this collection has no opinion on
    // whether you stamp, but if you do, the stamp is the server's.
    //
    // This closes the hazard freshStamp()'s own comment describes. Six write
    // paths — users/{uid}, sessions, meals, eatPrefs, mealPlans and splits —
    // accepted an `updatedAt` postdated to 2099, which pins a document at the
    // top of a range query forever. Measured, and now refused.
    function stampedIfTouched() {
      return !touches(['updatedAt']) || freshStamp();
    }

    // G8 §6's K3 contract: where a document carries `schemaV`, it is an int,
    // and where it carries `updatedAt`, the value is the server's own clock.
    //
    // THE PROSE HERE USED TO OVERSTATE THIS. It said "every client write
    // carries a schema version and a server-stamped `updatedAt`". Run against
    // an evaluator, that is false, and not narrowly: this function is reachable
    // from `measurements` and from nowhere else. The measured matrix is
    //
    //   REQUIRES schemaV          measurements
    //   REJECTS  schemaV          checkins, meals, eatPrefs, mealPlans,
    //                             firstWeek, users/{uid}
    //   REQUIRES a server stamp   cycle, periods
    //   STAMP IS OPTIONAL, and
    //   server-clocked if given   users/{uid}, sessions, meals, eatPrefs,
    //                             mealPlans, splits, measurements
    //
    // Those whitelists are deliberate and the client agrees with them —
    // `cloud_documents.dart` sends no `schemaV` for a check-in and no clock for
    // the first-week arc. Ten collections were NOT changed to match a sentence;
    // the sentence was corrected to match the ten collections. What every
    // client write does now carry is the second half, through
    // stampedIfTouched() above, and that is the half a forged clock attacks.
    function requiredMeta() {
      return request.resource.data.schemaV is int && freshStamp();
    }

    // Deterministic document ids. `isDay` is spine C1's replay defence: the id
    // IS the date, so a retried write collides with itself rather than becoming
    // a second entry.
    function isDay(id)  { return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function isWeek(id) { return id.matches('^[0-9]{4}-W[0-9]{2}$'); }

    // True when `other` has NOT blocked the caller.
    //
    // Costs one billed document read every time it is evaluated, so it guards
    // individual documents and must never be put on a list query — a feed of
    // 30 posts would bill 30 extra reads per page. G7 §6 is explicit about it.
    //
    // WHERE THIS IS CALLED, and why only there.
    //
    // The rules compiler reported this as defined but never called, which meant
    // blocking was enforced in the app and nowhere else — a client that skips
    // the app's own check could comment on, follow, or message someone who had
    // blocked them. It is now attached to four places, and every one of them is
    // a single-document WRITE:
    //
    //   1. posts/{postId}/comments — create
    //   2. followGraph/{owner}/{edge}/{other} — create and update
    //   3. relationships/{relId}/messages — create
    //   4. relationships/{relId} — create
    //
    // Writes, not reads, because the cost note above rules out attaching it to
    // anything a feed touches, and because a write is the thing that actually
    // reaches the person who blocked you. Comment creation pays two extra reads
    // (the parent post, then the block check); the others pay one. All four are
    // rare compared with the reads they sit beside.
    //
    // DELIBERATELY NOT ATTACHED TO:
    //
    //   * `posts/{postId}` read — that is the feed, and the feed is a list
    //     query. One block check per post per page is exactly the bill G7 §6
    //     forbids.
    //   * `publicProfiles/{uid}` read — two reasons. It is also a list query
    //     (profile search), and more importantly a rules denial returns
    //     PERMISSION_DENIED, which a client can tell apart from an empty
    //     result. The blockedBy mirror below is closed to everyone precisely so
    //     that "a blocked read returns the ordinary not-available state, never
    //     you-are-blocked". Putting this on a profile read would leak the very
    //     fact that comment is written to protect.
    //   * `reports/{reportId}` create — you must ALWAYS be able to report
    //     someone who has blocked you. A harasser who blocks his victim must
    //     not thereby silence her report.
    //   * `followGraph` delete — unfollowing someone who blocked you has to
    //     keep working, or a block traps a stale follow edge forever.
    function notBlockedBy(other) {
      return !exists(
        /databases/$(database)/documents/users/$(other)/blocks/$(request.auth.uid)
      );
    }

    // The author of a post, for the comment guard below. A separate function so
    // the extra get() is visible at the call site rather than buried in a
    // condition.
    function postAuthor(postId) {
      return get(/databases/$(database)/documents/posts/$(postId)).data.authorUid;
    }

    // Is this uid a coach at all?
    //
    // `isCoach()` answers that for the CALLER, from a claim, for free. There is
    // no equivalent for a third party: rules cannot read another account's
    // custom claims, so the only server-authored evidence available is the
    // existence of her coach page — which `coaches/{coachUid}` create gates on
    // `isCoach()`, i.e. on the server-minted claim. So the page is a durable
    // record that the claim was held.
    //
    // Costs one billed read, on relationship creation only. Before this
    // existed, `coachUid` on a new relationship was an arbitrary string the
    // caller chose, and choosing his own uid made `notBlockedBy(coachUid)`
    // trivially true — half of the escalation documented on the relationships
    // block below.
    function isRealCoach(someUid) {
      return exists(/databases/$(database)/documents/coaches/$(someUid));
    }

    // ------------------------------------------------ G7's two maps, by key
    //
    // `onlyTouches(['profile','privacy','notify','updatedAt'])` says WHICH maps
    // a client may write, and nothing at all about what may go inside them. So
    // `privacy: "yes"` or `notify: {quietStart: 99999}` were both accepted, and
    // the client half of every privacy promise in A03 rested on the app being
    // the only writer. These make the shape enforceable at the boundary.
    //
    // Deliberately stricter than G7 §6's snippet in one way: that version tests
    // `hasOnly` and then reads `...privacy.profileVisible is bool` directly. If
    // the key is absent, reading it is an error and the whole write is denied
    // rather than judged — a partial map write would fail with no explanation.
    // Requiring `hasAll` of the four booleans first makes the absence explicit
    // and the type checks safe to evaluate.
    function validPrivacy() {
      return !touches(['privacy']) || (
        request.resource.data.privacy.keys().hasOnly([
          'profileVisible', 'showBests', 'blurFacesDefault',
          'shareLogsWithCoach', 'policyVersion', 'updatedAt'
        ])
        && request.resource.data.privacy.keys().hasAll([
          'profileVisible', 'showBests', 'blurFacesDefault', 'shareLogsWithCoach'
        ])
        && request.resource.data.privacy.profileVisible     is bool
        && request.resource.data.privacy.showBests          is bool
        && request.resource.data.privacy.blurFacesDefault   is bool
        && request.resource.data.privacy.shareLogsWithCoach is bool
      );
    }

    // G2's map, by key.
    //
    // `profile` was the one map with no shape at all. `cloud_documents.dart`
    // says so in a comment beside the write — "nothing inside `profile` is
    // validated by the rules, which is why the three things with no collection
    // of their own live here" — and an evaluator run turned that into a
    // finding: `profile.idHmac` and `profile.verified` were both accepted.
    //
    // A claim-like or hash-like field is exactly as dangerous one level down as
    // it is at the top level, and spec §9.3 requirement 1 draws no such
    // distinction. The keys below are the `_userDoc()` writes, so this
    // is the client's own shape made enforceable rather than a new one.
    //
    // A partial write is normal here (the settings screen sends `goal` alone),
    // so this is `hasOnly` with no `hasAll`: absent is fine, foreign is not.
    function validProfile() {
      return !touches(['profile']) || (
        request.resource.data.profile.keys().hasOnly([
          'goal', 'place', 'equipment', 'days', 'minutes', 'lifeStage',
          'setupDone', 'allergies', 'dietary', 'language',
          'weekdays', 'level', 'minutesCustom'
        ])
      );
    }

    // Quiet hours are minutes past midnight, 0-1439. A value outside that range
    // is not a preference, it is a bug that silences her notifications forever.
    //
    // There is no outcome counter and no outcome array here to validate: spine
    // C6 makes suppression derivable from the notifications subcollection
    // rather than storable as a tally.
    function validNotify() {
      return !touches(['notify']) || (
        request.resource.data.notify.keys().hasOnly([
          'push', 'mealNudge', 'quietStart', 'quietEnd', 'kinds', 'usualMealHour'
        ])
        && request.resource.data.notify.keys().hasAll([
          'push', 'mealNudge', 'quietStart', 'quietEnd'
        ])
        && request.resource.data.notify.push       is bool
        && request.resource.data.notify.mealNudge  is bool
        && request.resource.data.notify.quietStart is int
        && request.resource.data.notify.quietStart >= 0
        && request.resource.data.notify.quietStart <= 1439
        && request.resource.data.notify.quietEnd   is int
        && request.resource.data.notify.quietEnd   >= 0
        && request.resource.data.notify.quietEnd   <= 1439
      );
    }

    // --------------------------------------------------- global invariants
    // AND-ed outside every per-group slice below. A slice can widen what fields
    // it writes; it can never escape these.

    // Rule 3 / spine C6: a run of consecutive days is not storable, so it cannot
    // be rendered. Enforced at the boundary rather than trusted to the client.
    // `missedDays`, `dailyStreak` and `daysStreak` were added after G6 pointed
    // out that the ban listed five spellings and not the three its own plan
    // uses. `missedDays` is the sharpest of them: a stored count of missed days
    // is exactly what P0-WEEK-02 forbids being shown, and a field cannot be
    // rendered if it cannot be written.
    function noRunCounter() {
      return !request.resource.data.keys().hasAny([
        'streak', 'streakDays', 'dayStreak', 'daysStreak', 'dailyStreak',
        'currentStreak', 'consecutiveDays', 'daysInARow', 'missedDays'
      ]);
    }

    // Spine C5: the single most security-critical line in the schema. If a client
    // can write its own verification result, the women-only gate is one line of
    // script away from being bypassed.
    function verificationUntouched() {
      return !touches(['verification']);
    }

    // G6: points, weeks, tiers and bests are server-written. A client that can
    // increment its own points can mint any tier.
    function rewardsUntouched() {
      return !touches(['rewards', 'weeklyGoal']);
    }

    function clientInvariants() {
      return noRunCounter() && verificationUntouched() && rewardsUntouched();
    }

    // ------------------------------------------------------ users/{uid}
    // ONE block. Every group's field permissions are OR-ed inside it.

    match /users/{uid} {
      allow read: if isSelf(uid);

      // CREATE AND UPDATE CARRY THE SAME WHITELIST. They did not, and the gap
      // was the widest hole in this file after the relationships one.
      //
      // `allow update` has named four writable maps since it was written.
      // `allow create` named none, so the document could simply be BORN holding
      // what it may never be changed to. Measured against an evaluator, ELEVEN
      // of eleven claim-like and hash-like payloads were accepted at create
      // time — `verified: true`, `admin: true`, `coachV: 'active'`, `idHmac`,
      // and a `nationalId` carrying a fourteen-digit Egyptian ID number.
      //
      // That last one is spec §9.3 requirement 1 violated literally, and it is
      // the exact shape §9.5's privacy scan exists to fail the build on: a
      // plaintext national ID at rest, written by the client, on the first
      // screen after sign-up.
      //
      // None of it bought a privilege — every gate in this file reads
      // `request.auth.token`, never a document field, and §04 proves a forged
      // `admin: true` opens nothing. The damage was the data itself.
      //
      // A create is a write of every key at once, and `changed()` returns every
      // key on a create, so the SAME four-map whitelist and the SAME three map
      // validators apply to both verbs from one place.
      allow create: if isSelf(uid) && phoneUser()
                    && clientInvariants()
                    && onlyTouches(['profile', 'privacy', 'notify', 'updatedAt'])
                    && validProfile()
                    && validPrivacy()
                    && validNotify()
                    && profileHealthOk(uid)
                    && stampedIfTouched();

      // G2 owns profile; G7 owns privacy and notify. Neither may reach the other
      // groups' maps, and neither may escape the invariants.
      // `onlyTouches` says which maps may be written; `validProfile`,
      // `validPrivacy` and `validNotify` say what may go inside them. Without
      // the second half, A03's switches were shape-checked by the app and by
      // nothing else.
      allow update: if isSelf(uid) && phoneUser()
                    && clientInvariants()
                    && onlyTouches(['profile', 'privacy', 'notify', 'updatedAt'])
                    && validProfile()
                    && validPrivacy()
                    && validNotify()
                    && profileHealthOk(uid)
                    && stampedIfTouched();

      // Deletion is a Cloud Function that purges by manifest; Firestore does not
      // cascade, so a client delete here would orphan every subcollection.
      allow delete: if false;

      // -- G3: the daily check-in. Deterministic id, so a replay collides.
      //
      // The field validator is G3 §6's `checkinFieldsOk`, merged verbatim. A
      // bare `read, write` accepted any shape, which matters more this week
      // than last: Y04 is gaining the sleep, bloating and bleeding controls,
      // and `bleeding == 'heavy'` is half of the severe-symptom gate. A value
      // the gate cannot recognise would not fail loudly — it would simply
      // never suppress, and she would be offered a workout on a day the
      // product promised not to.
      match /checkins/{day} {
        allow read: if isSelfVerified(uid);
        allow create, update: if isSelfVerified(uid) && phoneUser()
                              && hasHealthConsent(uid)
                              && isDay(day)
                              && noRunCounter()
                              && request.resource.data.keys().hasOnly([
                                   'energy', 'cramps', 'appetite',
                                   'sleep', 'bloating', 'bleeding'
                                 ])
                              && (!request.resource.data.keys().hasAny(['energy'])
                                  || request.resource.data.energy
                                       in ['low', 'ok', 'high'])
                              && (!request.resource.data.keys().hasAny(['appetite'])
                                  || request.resource.data.appetite
                                       in ['low', 'ok', 'high'])
                              && (!request.resource.data.keys().hasAny(['sleep'])
                                  || request.resource.data.sleep
                                       in ['poor', 'ok', 'good'])
                              && (!request.resource.data.keys().hasAny(['cramps'])
                                  || request.resource.data.cramps
                                       in ['none', 'mild', 'moderate', 'severe'])
                              && (!request.resource.data.keys().hasAny(['bloating'])
                                  || request.resource.data.bloating
                                       in ['none', 'mild', 'moderate', 'severe'])
                              && (!request.resource.data.keys().hasAny(['bleeding'])
                                  || request.resource.data.bleeding
                                       in ['none', 'spotting', 'light',
                                           'medium', 'heavy']);
        // The five-second undo (rule 9) deletes rather than confirms.
        allow delete: if isSelfVerified(uid);
      }

      // -- G4: sessions, with sets embedded (spine C2).
      match /sessions/{sessionId} {
        allow read: if isSelfVerified(uid);
        // Spine C8: a live session must be born with nothing logged. A recalled
        // or unplanned session is logged after the fact and is exempt.
        allow create: if isSelfVerified(uid) && phoneUser()
                      && noRunCounter()
                      && stampedIfTouched()
                      && (request.resource.data.source != 'live'
                          || request.resource.data.loggedSetCount == 0);
        allow update: if isSelfVerified(uid) && phoneUser()
                      && noRunCounter()
                      && stampedIfTouched()
                      && request.resource.data.source == resource.data.source;
        // A session is a record of something that happened, so it is not hers
        // to delete — with one exception, which the two-phase live write
        // creates and which `allow delete: if false` stranded.
        //
        // Spine C8 forces a live session to be BORN empty and filled
        // afterwards. If the app is killed between the two phases, a `live`
        // session with zero logged sets is left on the server: a record of
        // nothing, that she can see, that no client can remove, and that the
        // rule above will not let her re-create correctly either.
        //
        // So delete is open for exactly that document and no other. A session
        // with a set in it is still permanent, and `recalled` and `unplanned`
        // never take this path because they are created finished. `.get()`
        // rather than a bare field read: a birth document written by an older
        // build may carry neither key, and reading an absent field would error
        // and deny.
        allow delete: if isSelfVerified(uid)
                      && resource.data.get('source', '') == 'live'
                      && resource.data.get('loggedSetCount', -1) == 0;
      }

      // -- G5: one meal document per day (spine C3).
      //
      // A bare `read, write` was too wide. The shape is load-bearing here: C3
      // exists so two offline devices merge into ONE document per day by
      // arrayUnion rather than overwriting each other, and a write of the wrong
      // shape is how that silently becomes last-write-wins.
      //
      // The caps match the app's own kSlotItemCap, so the rules and the client
      // agree rather than each guessing. `.get(key, [])` is deliberate: a day
      // with no dinner logged yet has no `dinner` key, and indexing it directly
      // would fail the whole write.
      match /meals/{day} {
        allow read: if isSelfVerified(uid);
        allow write: if isSelfVerified(uid) && phoneUser()
                     && noRunCounter()
                     && stampedIfTouched()
                     && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                     && request.resource.data.keys().hasOnly([
                          'slots', 'totals', 'firstLogAt', 'tz',
                          'libVersion', 'updatedAt', 'skippedAt'
                        ])
                     && request.resource.data.get('slots', {}).keys().hasOnly([
                          'breakfast', 'lunch', 'dinner', 'snack'
                        ])
                     && request.resource.data.get('slots', {})
                          .get('breakfast', []).size() <= 24
                     && request.resource.data.get('slots', {})
                          .get('lunch', []).size() <= 24
                     && request.resource.data.get('slots', {})
                          .get('dinner', []).size() <= 24
                     && request.resource.data.get('slots', {})
                          .get('snack', []).size() <= 24
                     && request.resource.data.get('totals', {})
                          .get('kcal', 0) >= 0
                     && request.resource.data.get('totals', {})
                          .get('kcal', 0) <= 30000
                     && request.resource.data.get('totals', {})
                          .get('protein', 0) >= 0
                     && request.resource.data.get('totals', {})
                          .get('protein', 0) <= 2000;
        // A day is corrected by writing it, never by deleting it — the same
        // reasoning as sessions. Deleting a day would silently un-count it.
        allow delete: if false;
      }

      // -- G5: her usual plates and Eat preferences. Exactly one document.
      match /eatPrefs/{docId} {
        allow read: if isSelfVerified(uid);
        allow write: if isSelfVerified(uid) && phoneUser()
                     && noRunCounter()
                     && stampedIfTouched()
                     && docId == 'current'
                     && request.resource.data.keys().hasOnly([
                          'plates', 'ramadanMode', 'proteinTargetGOverride',
                          'libVersion', 'updatedAt'
                        ])
                     && request.resource.data.get('plates', {}).size() <= 40
                     && request.resource.data.get('ramadanMode', 'auto')
                          in ['auto', 'on', 'off'];
        allow delete: if false;
      }

      // -- G5: the week's dinner plan and its grocery list.
      match /mealPlans/{weekId} {
        allow read: if isSelfVerified(uid);
        allow write: if isSelfVerified(uid) && phoneUser()
                     && noRunCounter()
                     && stampedIfTouched()
                     && weekId.matches('^[0-9]{4}-W[0-9]{2}$')
                     && request.resource.data.keys().hasOnly([
                          'dinners', 'groceries', 'recipeVersion', 'updatedAt'
                        ])
                     && request.resource.data.get('dinners', {}).keys().hasOnly([
                          'mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'
                        ])
                     && request.resource.data.get('groceries', []).size() <= 120;
        // Hers to clear. A week plan is a convenience, not a record of what
        // happened — unlike a meal day, nothing is lost by removing it.
        allow delete: if isSelfVerified(uid);
      }

      // -- What she has paid for. Server-minted, exactly as `verified`, `coachV`
      //    and `admin` already are.
      //
      // `{ tier, source, expiresAt, updatedAt }`, written by a Cloud Function
      // that has validated a store receipt, or by an admin granting one. A
      // client-asserted entitlement is not an entitlement; it is a suggestion,
      // and the whole point of putting it in its own document rather than in
      // `profile` is that `profile` is client-writable.
      //
      // Nothing reads this yet. `Feature.payments` is off, every recipe is
      // free, and `RecipeAccessGate` returns open for all of them. It is here
      // because the alternative is adding it the week money starts moving,
      // which is the week nobody has time to think about it.
      match /private/{docId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // -- G6: server-written. A client may read its own progress, never write it.
      match /weeks/{weekId}      { allow read: if isSelfVerified(uid); allow write: if false; }
      match /bests/{exerciseId}  { allow read: if isSelfVerified(uid); allow write: if false; }
      match /awards/{awardId}    { allow read: if isSelfVerified(uid); allow write: if false; }

      // -- G6: measurements are hers alone. Never queried across users, and the
      //    index exemptions make that unexecutable rather than merely denied.
      // Rule 11 at the storage layer. With a key whitelist, no `sharedWith`,
      // `public` or `rank` field can ever come into existence here — so there
      // is nothing for a later feature to expose by accident. A bare
      // `allow read, write` left that open, and these are her body
      // measurements.
      //
      // The K3 metadata fields are INSIDE the whitelist, deliberately: G6 §1.2
      // records that omitting them would have made its own rule reject every
      // conformant write.
      match /measurements/{day} {
        allow read: if isSelfVerified(uid);
        allow create, update: if isSelfVerified(uid) && phoneUser()
                              && hasHealthConsent(uid)
                              && isDay(day)
                              && noRunCounter()
                              && requiredMeta()
                              && request.resource.data.keys().hasOnly([
                                   'weightKg', 'waistCm', 'hipsCm', 'armCm',
                                   'thighCm', 'takenAt', 'note',
                                   'schemaV', 'updatedAt', 'clientWrittenAt',
                                   'opId'
                                 ]);
        allow delete: if isSelfVerified(uid);
      }

      // -- G9: cycle. The most sensitive data in the product. A coach NEVER reads
      //    it through a membership check here — she reads a Function-written
      //    projection, and only while the grant on the relationship is live.
      //
      // `allow read, write: if isSelf(uid)` was too wide in both directions, and
      // G9 §6 says why. `read` grants `list`, and there is no cycle query, for
      // anyone, ever — one document, fixed id. `write` accepted any shape, so
      // nothing stopped a stored `phase`, `cycleDay` or `fertileWindow`, which
      // is §2.4 defeated at the storage layer rather than in the UI.
      match /cycle/{docId} {
        function cycleOk(d) {
          return d.keys().hasOnly([
                   'mode', 'contextFlags', 'cycleLengthDays', 'adaptation',
                   'sharing', 'lastPeriod', 'recentStarts',
                   'schemaV', 'updatedAt', 'clientWrittenAt', 'opId'
                 ])
            && (!d.keys().hasAny(['mode'])
                || d.mode in ['datesAndSymptoms', 'symptomsOnly'])
            && (!d.keys().hasAny(['contextFlags'])
                || (d.contextFlags is list && d.contextFlags.size() <= 6))
            && (!d.keys().hasAny(['recentStarts'])
                || (d.recentStarts is list && d.recentStarts.size() <= 12))
            && (!d.keys().hasAny(['cycleLengthDays'])
                || d.cycleLengthDays == null
                || (d.cycleLengthDays is int
                    && d.cycleLengthDays >= 21
                    && d.cycleLengthDays <= 45))
            && (!d.keys().hasAny(['adaptation'])
                || d.adaptation.keys().hasOnly([
                     'workoutSuggestions', 'mealSuggestions',
                     'homeCard', 'easierWhenLowEnergy'
                   ]))
            && (!d.keys().hasAny(['sharing'])
                || d.sharing.keys().hasOnly([
                     'energyAppetite', 'symptoms',
                     'datesAndPatterns', 'grantedForRelId'
                   ]))
            // §2.4 at the storage layer: a phase, a cycle day and a prediction
            // are not things this product decides, so they are not things this
            // document can hold.
            && !d.keys().hasAny([
                 'phase', 'cycleDay', 'predictedOvulation',
                 'fertileWindow', 'forecast'
               ]);
        }

        allow get:  if isSelfVerified(uid);
        allow list: if false;
        allow create, update: if isSelfVerified(uid) && phoneUser()
                              && hasHealthConsent(uid)
                              && docId == 'current'
                              && noRunCounter()
                              && freshStamp()
                              && cycleOk(request.resource.data);
        allow delete: if isSelfVerified(uid);          // Y12 "Delete cycle data"
      }

      // The document id IS the start date (C1), so a replayed log collides with
      // itself instead of creating a second period.
      match /periods/{day} {
        function asDate(s) {
          return timestamp.date(int(s[0:4]), int(s[5:7]), int(s[8:10]));
        }

        function periodOk(d) {
          return d.keys().hasOnly([
                   'start', 'end', 'stillBleeding', 'editedAt',
                   'schemaV', 'updatedAt', 'clientWrittenAt', 'opId'
                 ])
            && d.start == day                    // id and field can never disagree
            && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.stillBleeding is bool
            && d.stillBleeding == (d.end == null)  // and can never contradict
            && (d.end == null
                || (d.end is string
                    && d.end.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && d.end >= d.start))        // ISO dates compare lexically
            // No bleeding in the future. One day of slack for a device whose
            // timezone is ahead of the server's.
            && asDate(d.start) <= request.time + duration.value(1, 'd')
            && (d.end == null
                || asDate(d.end) <= request.time + duration.value(1, 'd'));
        }

        allow get:  if isSelfVerified(uid);
        allow list: if isSelfVerified(uid);            // Y08's bounded range, owner only
        allow create, update: if isSelfVerified(uid) && phoneUser()
                              && hasHealthConsent(uid)
                              && noRunCounter()
                              && freshStamp()
                              && periodOk(request.resource.data);
        allow delete: if isSelfVerified(uid);          // Y09 delete
      }

      // -- G4/G14: a split she authored herself (DECISIONS D7).
      //
      // `allow write` silently covers DELETE, and `request.resource` is null on
      // a delete — so `request.resource.data.ownerKind` was a read of a field
      // on nothing. That errors, and an error denies. D7 says the split is
      // hers; measured, she could create one and never remove it.
      //
      // Stating the three verbs separately is the fix and also the lesson: a
      // guard written in terms of `request.resource` belongs on `create` and
      // `update`, never on `write`.
      match /splits/{splitId} {
        allow read: if isSelfVerified(uid);
        allow create, update: if isSelfVerified(uid) && phoneUser()
                              && noRunCounter()
                              && stampedIfTouched()
                              && request.resource.data.ownerKind == 'self';
        allow delete: if isSelfVerified(uid);
      }

      // -- G8: her devices. One of the gate exceptions named in the header:
      // the push token is registered before the camera opens, and the
      // verification result is delivered to it.
      //
      // It was `allow read, write: if isSelf(uid)` with no whitelist and no
      // invariants — the only collection in this file that accepted any shape
      // at all. Measured, it took `streak: 40` and `idHmac` from an unverified
      // account. A token registration is four fields; nothing else belongs in a
      // collection that sits outside the whole-app gate.
      match /devices/{deviceId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && phoneUser()
                              && noRunCounter()
                              && stampedIfTouched()
                              && request.resource.data.keys().hasOnly([
                                   'token', 'platform', 'appVersion',
                                   'locale', 'updatedAt'
                                 ]);
        allow delete: if isSelf(uid);      // sign-out retires the token
      }

      // -- G7: the notification inbox (A01).
      //
      // Function-written, with a 30-day TTL on `expiresAt` — that TTL is what
      // keeps A01 a bounded read forever instead of a scan that grows with the
      // account's age. She may mark one read, or record how she answered a
      // nudge, and nothing else: a client that could create its own
      // notification could put any text in front of any woman.
      match /notifications/{notifId} {
        allow get, list: if isSelf(uid);
        allow create, delete: if false;
        allow update: if isSelf(uid) && phoneUser()
                      && onlyTouches(['read', 'readAt', 'outcome'])
                      && (!touches(['outcome'])
                          || request.resource.data.outcome
                               in ['logged', 'ignored', 'dismissed']);
      }

      // -- G7: who she has blocked (A04).
      //
      // The document id IS the blocked uid, so a replayed block collides with
      // itself rather than stacking (spine C1) — which is what makes blocking
      // safe to write offline. Unblocking is hers; the mirror below is not.
      match /blocks/{blockedUid} {
        allow get, list: if isSelf(uid);
        allow create, update: if isSelf(uid) && phoneUser()
                      && blockedUid != uid
                      && request.resource.data.keys().hasOnly(
                           ['createdAt', 'source'])
                      && request.resource.data.source
                           in ['post', 'profile', 'message', 'safety_centre']
                      && serverStamped('createdAt');
        allow delete: if isSelf(uid);
      }

      // -- G7: the reverse mirror, Function-written.
      //
      // Closed to EVERYONE, including the woman it belongs to, and that is the
      // point: nobody learns who blocked them. A blocked read returns the
      // ordinary "not available" state, never "you are blocked", so blocking
      // someone cannot become a way of telling them.
      match /blockedBy/{blockerUid} {
        allow read, write: if false;
      }

      // -- G7: "Reports you made" (A04). A Function-written mirror, so she can
      //    follow her own report without the moderation queue ever being
      //    client-readable.
      match /myReports/{reportId} {
        allow get, list: if isSelf(uid);
        allow write: if false;
      }

      // -- G1: her consent trail (PDPL).
      //
      // Verbatim from G1 §6. Declared nowhere until now, so it fell through to
      // the catch-all and was denied in BOTH directions — which sounds safe and
      // is not: PDPL gives her a right of access to her own consent records,
      // and deny-all blocked her from reading them. Writing stays closed: a
      // consent record is minted by the ConsentService callable with a
      // server timestamp and a server-side hash of the policy text, because a
      // client-written consent record proves nothing.
      match /consents/{consentId} {
        allow get, list: if isSelf(uid);
        allow write: if false;
      }

      // -- G3: shown-once notices.
      //
      // Verbatim from G3 §6. The document id IS `kind-week`, and the rule
      // requires the id to equal the data — so "shown once, never again that
      // week" (P0-WEEK-03) is structural rather than a flag someone has to
      // check. A replayed offline write collides with itself and cannot
      // re-show the notice.
      //
      // `isSelf` raised to `isSelfVerified`: both kinds, `quietWeek` and
      // `tierSlip`, describe a training week she cannot have had yet, so an
      // unverified account had nothing here to acknowledge. It was reachable
      // outside the gate and undocumented, which is the pair of facts that
      // makes a gate exception a hole rather than a decision.
      match /notices/{noticeId} {
        allow read: if isSelfVerified(uid);
        allow create, update: if isSelfVerified(uid) && phoneUser()
                              && noRunCounter()
                              && request.resource.data.keys().hasOnly([
                                   'kind', 'forWeek', 'seenAt'
                                 ])
                              && request.resource.data.kind in [
                                   'quietWeek', 'tierSlip'
                                 ]
                              && isWeek(request.resource.data.forWeek)
                              && noticeId ==
                                   request.resource.data.kind + '-' +
                                   request.resource.data.forWeek
                              && request.resource.data.seenAt == request.time;
        // An acknowledgement is not retractable.
        allow delete: if false;
      }

      // -- G3: the first-week arc. One document, fixed id `arc`.
      //
      // Booleans only, and HANDOFF rule 17 in enforceable form: with no
      // `expiresAt`, `deadline` or `failedAt` storable, the first week has no
      // deadline and no failure state, so it cannot be something she loses.
      match /firstWeek/{docId} {
        allow read: if isSelfVerified(uid);
        allow create, update: if isSelfVerified(uid) && phoneUser()
                              && docId == 'arc'
                              && noRunCounter()
                              && request.resource.data.keys().hasOnly([
                                   'hasAnyLog', 'steps', 'completedAt'
                                 ])
                              && request.resource.data.hasAnyLog is bool
                              && request.resource.data.steps.keys().hasOnly([
                                   'logSet', 'logMeal', 'finishSession',
                                   'joinGroup', 'followUp'
                                 ])
                              && !request.resource.data.keys().hasAny([
                                   'expiresAt', 'deadline', 'failedAt'
                                 ]);
        allow delete: if false;
      }
    }

    // ------------------------------------------------ coaches/{coachUid}
    // ONE block, for the same reason. G12 (profile, offers), G13 (portfolio,
    // results, ads) and G14 (splits) are OR-ed slices inside it.

    match /coaches/{coachUid} {
      // A coach's public face is readable by any VERIFIED woman. It was
      // `signedIn()`; under the whole-app gate, browsing coaches is using the
      // product. A coach reading her own page is exempt so she is not locked
      // out of her own profile while her own verification is pending.
      allow read: if isVerified() || isSelf(coachUid);

      // THE THREE TRUST SIGNALS, AT BIRTH AS WELL AS AFTER IT.
      //
      // `allow update` has refused `verifiedCerts`, `coachV` and `rating` since
      // it was written. `allow create` refused nothing, so a coach page could
      // be BORN with `rating: 5.0` and
      // `verifiedCerts: ['NASM', 'ACE', 'anything at all']` — measured, and
      // read back by a verified woman browsing coaches.
      //
      // These three are not cosmetic. They are the entire basis on which a
      // woman decides who she lets design her training and, for in-person
      // coaching, who she stands in a room with. `rating` is aggregated by a
      // Function from real reviews; `verifiedCerts` is written after a
      // credential check; `coachV` mirrors the server-minted claim that gated
      // this create in the first place, so a client copy of it adds nothing but
      // a second version of the truth.
      //
      // `hasAny` on the new document's own keys rather than `touches()`,
      // because on a create the two are the same thing and this spelling says
      // plainly that the field may not exist, not merely that it may not change.
      allow create: if coachLive()
                    && isSelf(coachUid)
                    && isCoach()
                    && !request.resource.data.keys().hasAny([
                         'verifiedCerts', 'coachV', 'rating'
                       ]);
      allow update: if coachLive()
                    && isSelf(coachUid)
                    && isCoach()
                    && !touches(['verifiedCerts', 'coachV', 'rating']);
      allow delete: if false;

      // G13: a published portfolio is readable by anyone signed in, because a
      // woman choosing a coach must be able to see it before she commits.
      match /portfolio/{version} {
        allow read: if signedIn() && resource.data.published == true
                    || isSelf(coachUid);
        allow create, update: if coachLive() && isSelf(coachUid) && isCoach();
        allow delete: if isSelf(coachUid) && isCoach();
      }

      match /offers/{offerId} {
        allow read: if signedIn();
        allow create, update: if coachLive() && isSelf(coachUid) && isCoach();
        allow delete: if isSelf(coachUid) && isCoach();
      }

      // G13 / spine C10: a client result is publishable only while consent is
      // active, checked at READ time so withdrawal takes effect everywhere at
      // once — including inside already-composed ad creatives.
      match /results/{resultId} {
        allow read: if isSelf(coachUid)
                    || (signedIn() && resource.data.consentState == 'granted');
        allow create, update: if coachLive() && isSelf(coachUid) && isCoach();
        allow delete: if isSelf(coachUid) && isCoach();
      }

      match /ads/{adId} {
        allow read, delete: if isSelf(coachUid) && isCoach();
        allow create, update: if coachLive() && isSelf(coachUid) && isCoach();
      }
      match /splits/{splitId} {
        allow read, delete: if isSelf(coachUid) && isCoach();
        allow create, update: if coachLive() && isSelf(coachUid) && isCoach();
      }

      // K02. Her certificate records, written only by submit_coach_certificate
      // and moved on only by a woman reviewer through the Admin SDK, so a coach
      // can never mark her own certificate checked. She reads her own.
      match /certificates/{certificateId} {
        allow read: if isSelf(coachUid);
        allow write: if false;
      }
    }

    // ------------------------------------------------------- relationships
    // relId is exactly {coachUid}__{clientUid}; the Storage rules parse it, so
    // the spelling is load-bearing.

    match /relationships/{relId} {
      // WHICH DOCUMENT IS `resource`?
      //
      // Inside THIS match, `resource` is the relationship. Inside the nested
      // `messages` and `reviews` matches it is the message or the review, and
      // a helper declared up here does not change that — a function in rules is
      // inlined at its call site, so it reads whatever `resource` means THERE.
      //
      // The old comment beside `messages` asserted the opposite ("`resource` is
      // the parent relationship document, which is already loaded for
      // isParty()"). It was simply wrong, and the consequences were not subtle:
      //
      //   * message create was DENIED for the coach, DENIED for the client, and
      //     DENIED on the happy path for both, because a message document has
      //     no `coachUid` — reading an absent field errors, and an error denies.
      //     Coach messaging was entirely unusable.
      //   * message read was granted to any verified stranger whose uid happened
      //     to appear in a `coachUid` or `clientUid` field ON THE MESSAGE. Access
      //     was decided by the document being read rather than by the
      //     relationship it lives in.
      //   * `notBlockedBy` on message create had therefore never once been
      //     reached, so the blocking test passed for the wrong reason: nobody
      //     could message at all.
      //
      // So the party check now comes in two spellings, and the name says which
      // document each one reads. Sibling matches must use `isPartyOfParent()`.
      function isPartyOf(rel) {
        return isVerified()
               && (request.auth.uid == rel.coachUid
                   || request.auth.uid == rel.clientUid);
      }

      // Valid ONLY in this match, where `resource` is the relationship itself.
      function isParty() {
        return isPartyOf(resource.data);
      }

      // Valid anywhere under this match. Costs one billed read of the parent.
      // Rules cache repeated access to the same document within one request, so
      // listing a thread of 200 messages pays for the parent once, not 200
      // times — but a point-read of a single message does now cost one extra
      // read, which the previous (broken) rule did not. That is the price of
      // deciding access from the relationship instead of from the message, and
      // it also means a message under a relationship that does not exist is
      // denied rather than judged on its own contents.
      function parent() {
        return get(/databases/$(database)/documents/relationships/$(relId)).data;
      }

      function isPartyOfParent() {
        return isPartyOf(parent());
      }

      allow read: if isParty();

      // HORIZONTAL PRIVILEGE ESCALATION — the hole this shape used to leave.
      //
      // The rule was `signedIn() && clientUid == request.auth.uid &&
      // notBlockedBy(coachUid)`. Three things it never checked, and what each
      // one cost:
      //
      //   1. `relId` was never compared with the document's own fields. The
      //      caller chose the id. `plans/{uid}` below granted read to anyone for
      //      whom `relationships/{callerUid}__{uid}` merely EXISTED, so writing
      //      a document at that id was a read grant over another woman's entire
      //      plan tree. Measured: 4 of 4 plan reads leaked, with real content.
      //   2. `coachUid` was never required to be a coach. Setting it to his own
      //      uid made `notBlockedBy(coachUid)` a check on whether he had blocked
      //      himself — so BLOCKING HIM DID NOT CLOSE IT. The victim's block sits
      //      at `users/{victim}/blocks/...` and was never consulted.
      //   3. `signedIn()` rather than the gate. It worked WITHOUT the `verified`
      //      claim, which put it entirely outside the women-only premise this
      //      product is built on.
      //
      // The victim could not see the forged edge, could not list relationships,
      // and could not delete it.
      //
      // All three are closed here, and the plans rule below stops trusting a
      // bare `exists()` as well. Either fix alone would have closed the measured
      // attack; both are applied because the id constraint is what makes the
      // relationship collection honest, and the field check is what stops the
      // next rule that keys off a client-writable path from inheriting the bug.
      //
      // Two billed reads on create: the coach page, then the block check.
      // Relationships are opened once per coaching engagement.
      allow create: if coachLive()
                    && isSelfVerified(request.resource.data.clientUid)
                    && relId == request.resource.data.coachUid + '__'
                                + request.resource.data.clientUid
                    && isRealCoach(request.resource.data.coachUid)
                    && notBlockedBy(request.resource.data.coachUid)
                    // Money state, lifecycle state and the sharing grant are
                    // server-written. `allow update` has always said so; a
                    // document that could be born holding them said otherwise.
                    // `grantedForRelId` is the cycle-sharing grant — the key
                    // that opens the most sensitive data in the product.
                    && !request.resource.data.keys().hasAny([
                         'payment', 'status', 'grantedForRelId'
                       ]);

      // Money state and the sharing grant are server-written.
      allow update: if coachLive()
                    && isParty()
                    && !touches(['payment', 'status', 'grantedForRelId']);
      allow delete: if false;

      // Rule 2: a message never changes a plan. A message document may not carry
      // plan fields at all, so "the coach changed my plan in chat" is not a shape
      // this collection can hold.
      match /messages/{msgId} {
        allow read: if isPartyOfParent();
        // The counterparty is whichever of the two parties is not the sender,
        // read from the PARENT relationship — the same cached document
        // `isPartyOfParent()` already loaded. One further billed read for the
        // block check itself.
        allow create: if coachLive()
                      && isPartyOfParent()
                      && request.resource.data.senderUid == request.auth.uid
                      && notBlockedBy(
                           request.auth.uid == parent().coachUid
                             ? parent().clientUid
                             : parent().coachUid)
                      && !request.resource.data.keys().hasAny(
                           ['planVersion', 'assignments', 'published']);
        allow update, delete: if false;
      }

      match /reviews/{reviewId} {
        allow read, delete: if isPartyOfParent();
        allow create, update: if coachLive() && isPartyOfParent();
      }
    }

    // ------------------------------------------------------------- plans
    // G2 authors plans; a coach reads her client's under an active relationship.
    // Publishing is a Function, because publishing is what changes a plan.

    match /plans/{uid}/{document=**} {
      // NEVER TRUST A BARE exists() ON A CLIENT-WRITABLE PATH.
      //
      // This rule used to read, in full:
      //
      //   exists(/databases/$(database)/documents/relationships/
      //          $(request.auth.uid + '__' + uid))
      //
      // and that is the whole vulnerability in one line. `relationships` is
      // client-creatable and the caller chose the document id, so the condition
      // reduced to "has this caller written a document at a path he computed
      // himself?". Every signed-in account could answer yes about every woman
      // in the product, and did: 4 of 4 plan reads leaked, including the
      // published plan's text.
      //
      // `exists()` answers "is something there". It never answers "does what is
      // there say what I am about to assume it says". On a path a client can
      // write, only the second question is worth asking.
      //
      // So the relationship is now LOADED and its fields are checked: it must
      // name this caller as the coach and this `uid` as the client, which is
      // also exactly what the id spells — an edge that disagrees with its own
      // id grants nothing. `isCoach()` first, so a woman without the
      // server-minted coach claim is refused before any document is read, and
      // so `request.auth.uid` is never dereferenced on an anonymous call.
      //
      // Cost: one billed read on the coach's path only. She is reading her
      // client's plan, which is several reads already; the woman reading her own
      // plan takes the left branch and pays nothing.
      function relWith(clientUid) {
        return /databases/$(database)/documents/relationships/$(request.auth.uid + '__' + clientUid);
      }

      function coachOnActiveRelationship(clientUid) {
        return isCoach()
               && isVerified()
               && exists(relWith(clientUid))
               && get(relWith(clientUid)).data.coachUid == request.auth.uid
               && get(relWith(clientUid)).data.clientUid == clientUid;
      }

      allow read: if isSelfVerified(uid)
                  || coachOnActiveRelationship(uid);
      allow write: if false;
    }

    // -------------------------------------------------------- community
    // Spine C9: the feed is assembled on READ. Nothing here fans out on write.

    match /posts/{postId} {
      allow read: if isVerified();
      // `clientInvariants()` is AND-ed outside every slice of `users/{uid}`,
      // and outside nothing else — so a post could be born with `streak: 40`,
      // which is rule 3 defeated by writing it somewhere the invariant does not
      // reach. `counts` is the same asymmetry as everywhere else in this file:
      // `allow update` refuses to let a client touch the server-maintained
      // tallies, and `allow create` let a post be born with
      // `counts.likes = 99999`. Both measured as ALLOWED.
      allow create: if communityLive()
                    && isVerified()
                    && request.resource.data.authorUid == request.auth.uid
                    // Rule 6: blur defaults on, applied on-device before upload.
                    && request.resource.data.blurred is bool
                    && noRunCounter()
                    && !request.resource.data.keys().hasAny(['counts']);
      allow update: if communityLive()
                    && isVerified()
                    && resource.data.authorUid == request.auth.uid
                    // Counts are server-maintained; a client cannot inflate them.
                    && !touches(['counts', 'authorUid', 'createdAt']);
      // A gate exception, named in the header: taking her own photograph down
      // must not depend on a claim she might lose.
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isVerified();
        // Two extra billed reads on a comment CREATE only: one to learn whose
        // post it is, one for the block check. Creates are rare beside reads,
        // and the alternative — a blocked man able to comment under her posts
        // because the only check lived in the app — is not a trade.
        allow create: if communityLive()
                      && isVerified()
                      && request.resource.data.authorUid == request.auth.uid
                      && noRunCounter()
                      && !request.resource.data.keys().hasAny(['counts'])
                      && notBlockedBy(postAuthor(postId));
        allow update: if false;
        // Same exception, same reason, as `posts` delete above.
        allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
      }
    }

    match /publicProfiles/{uid} {
      // notBlockedBy is deliberately NOT here. See the note at its definition:
      // this is a list query, and a rules denial is distinguishable from an
      // empty result, which would turn a block into a signal.
      allow read: if isVerified();
      allow write: if false; // Function-maintained projection.
    }

    match /followGraph/{ownerUid}/{edge}/{otherUid} {
      allow read: if isVerified();
      // One extra billed read per follow. Split from `write` on purpose:
      // DELETE must stay open, because unfollowing someone who blocked you has
      // to keep working or the block traps a stale edge forever.
      //
      // `isSelf` raised to `isSelfVerified` on the two verbs that ADD an edge:
      // following someone is using the community, and the read side of this
      // same collection has always been `isVerified()`. Delete deliberately
      // stays `isSelf` — the argument that keeps it outside `notBlockedBy()`
      // keeps it outside the gate too, and an account with no claim has no
      // business being unable to undo an edge it can no longer create.
      allow create, update: if communityLive()
                            && isSelfVerified(ownerUid)
                            && notBlockedBy(otherUid);
      allow delete: if isSelf(ownerUid);
    }

    match /groups/{groupId} {
      allow read: if isVerified();
      allow write: if false;

      // Her own membership document, and nothing else.
      //
      // Two findings here. `allow read` grants LIST, and the client says the
      // opposite in three separate files — "`groups/{gid}/members` is
      // `allow list: if false` in the rules, so a roster is not something this
      // screen can build", "4,210 women are not a list to scrape". The rules
      // did not say that; they do now, and `get` is left open so she can see
      // whether she has joined.
      //
      // And `allow write: if isSelf(uid)` accepted any shape from an unverified
      // account: measured, `role: 'admin'`, `moderator: true` and `streak: 99`
      // were all written. No rule in this file reads those fields, so nothing
      // was granted — but a `role: 'admin'` sitting on a membership document is
      // a trap for the first feature that decides to trust one.
      match /members/{uid} {
        allow get:  if isVerified();
        allow list: if false;
        allow create, update: if communityLive()
                              && isSelfVerified(uid)
                              && noRunCounter()
                              && stampedIfTouched()
                              && request.resource.data.keys().hasOnly([
                                   'at', 'joinedAt', 'mutedUntil', 'updatedAt'
                                 ]);
        allow delete: if isSelfVerified(uid);     // leaving a group is hers
      }
    }

    // ---------------------------------------------------------- moderation
    // She can report; she can never read the queue, and she can never learn
    // whether a report led anywhere.

    // The moderation queue. She reads her own mirror at users/{uid}/myReports;
    // this collection is never client-readable, because a readable report queue
    // tells a harasser who reported him.
    //
    // Only `reporterUid` was checked before, which left three holes that matter:
    // `createdAt` was forgeable, so the one-hour first-response clock could be
    // set to any time; `note` was unbounded; and `reason` was free text, so the
    // triage categories the safety team sorts by were whatever a client sent.
    match /reports/{reportId} {
      allow get, list: if false;
      allow create: if signedIn()
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.subjectUid != request.auth.uid
                    // A report about a person is always open. One about a post
                    // or a comment is about the community, and waits for it.
                    && (communityLive()
                        || !(request.resource.data.get('subjectKind', '')
                             in ['post', 'comment']))
                    && request.resource.data.state == 'submitted'
                    && serverStamped('createdAt')
                    && request.resource.data.get('note', '').size() <= 1000
                    && request.resource.data.reason in [
                         'harassment', 'man_account', 'nudity', 'spam',
                         'impersonation', 'self_harm', 'other'
                       ]
                    && request.resource.data.keys().hasOnly([
                         'reporterUid', 'subjectUid', 'subjectKind', 'subjectRef',
                         'reason', 'note', 'state', 'createdAt', 'locale',
                         'appVersion'
                       ]);
      // Moderators act through the Admin SDK, which bypasses rules entirely.
      allow update, delete: if false;
    }

    // A02's proof of erasure. She may watch her own deletion run; she may not
    // write it, because a client that could set `state: 'done'` could make the
    // app tell her she was deleted when she was not.
    match /deletionRequests/{uid} {
      allow get:   if isSelf(uid);
      allow list:  if false;
      allow write: if false;
    }

    // ------------------------------------------------------- assessments
    // An assessment is a coach's written record of a woman's body, her injuries
    // and her clearance to train. `allow create` was `signedIn() && isCoach()`
    // and nothing else — no field constraints at all. Measured, a coach could
    // create an assessment ATTRIBUTED TO ANOTHER COACH, one about a woman who
    // never hired her, and — because the rule never asked for the `verified`
    // claim — one written by a coach account that had not passed the gate.
    //
    // Read is already correct: only the two named parties. So the fix is to
    // make the write side name the same two people, and to require the
    // relationship that makes the second one her client.
    //
    // One billed read on create. An assessment is written once per client.
    match /assessments/{assessmentId} {
      allow read: if isVerified()
                  && (request.auth.uid == resource.data.clientUid
                      || request.auth.uid == resource.data.coachUid);
      allow create: if isVerified()
                    && isCoach()
                    && request.resource.data.coachUid == request.auth.uid
                    && request.resource.data.clientUid is string
                    && exists(/databases/$(database)/documents/relationships/$(request.auth.uid + '__' + request.resource.data.clientUid));
      // P0-ASMT-05, quoted in assessment_repository.dart: "No UI path edits a
      // recorded assessment. A direct write is denied by rules; the only
      // permitted update is the status flip to superseded. Deletion is denied
      // outright. Correcting means recording a new one." The rule said only
      // that the owning coach may change anything at all, which is not the
      // same sentence. An answer she gave about her own body cannot be quietly
      // rewritten afterwards.
      allow update: if isVerified()
                    && isCoach()
                    && request.auth.uid == resource.data.coachUid
                    && onlyTouches(['status', 'updatedAt'])
                    && stampedIfTouched()
                    && request.resource.data.status in ['recorded', 'superseded'];
      allow delete: if false;
    }

    // ------------------------------------------------------------ libraries
    // Immutable content. Read by everyone, written by the content pipeline only.

    // The content library. DECISIONS.md D12 / plan G16.
    //
    // These were `write: if false` for everyone, which meant the library could
    // not be authored from anywhere — and it is empty, which is exactly why
    // P0-EAT-01 cannot pass and the exercise safety filter has nothing to
    // filter on. Admin writes them through the console; members still cannot.
    //
    // Read stays signedIn(): this is a women-only product and the library sits
    // behind the same gate as everything else.
    // Reads were `signedIn()`. Under the whole-app gate they are `isVerified()`:
    // the library is what the product is made of, and an unverified account
    // browsing the full exercise and recipe catalogue is using the product.
    // `isAdmin()` writes, and reads too: grant_admin.py sets the admin claim
    // and never `verified` (the console is let past the women-only gate
    // without an ID check), and the console reads every list before it writes.
    // Admin opens the library only, never a woman's own documents.
    match /exercises/{id} { allow read: if isVerified() || isAdmin(); allow write: if isAdmin(); }
    match /foods/{id}     { allow read: if isVerified() || isAdmin(); allow write: if isAdmin(); }
    match /programs/{id}  { allow read: if isVerified() || isAdmin(); allow write: if isAdmin(); }

    // Recipes carry two things the other three libraries do not: an allergen
    // set a woman's safety depends on, and a tier.
    //
    // **Two people, enforced here rather than in Dart.** A recipe may not be
    // written with a null `allergenReviewedBy`, and may not be written with a
    // reviewer who is also its author. Both are put in the rules because a Dart
    // bug, an admin console regression or a hand-run import script can all
    // bypass a client-side check, and the thing being checked is whether
    // somebody actually looked at what is in the dish.
    //
    // **The tier gate is written now and is inert now.** Every seeded recipe is
    // `free`, `Feature.payments` is off and `Feature.recipeTiering` cannot be
    // switched on above it, so this clause never refuses anything today. It is
    // here because a client-side lock is a lie if the document is readable
    // anyway: the day a `pro` recipe exists, it must not be *readable* by a
    // free account, and adding that rule afterwards means a window in which it
    // was.
    //
    // `request.auth.token.tier` is a custom claim and not a document read. The
    // reason is the one already recorded on `isVerified()`: a `get()` in a rule
    // bills one extra read on every gated operation. The cost of a claim is
    // staleness — up to an hour — so a purchase flow has to force
    // `getIdToken(true)` afterwards or she pays and waits.
    match /recipes/{id} {
      //
      // `resource == null` is the missing-document case and it has to come
      // first: reading a recipe that does not exist is a normal miss, and
      // evaluating `resource.data.tier` on it throws rather than denying, which
      // turns every 404 into a rules error.
      // The console reads every recipe, whatever its tier, to edit it.
      allow read: if isAdmin()
                  || (isVerified()
                      && (resource == null
                          || !('tier' in resource.data)
                          || resource.data.tier == 'free'
                          || request.auth.token.tier == 'pro'));
      //
      // `in` before `!=`: a document with no `allergenReviewedBy` key at all
      // throws on the comparison rather than failing it, and a rules error and
      // a rules denial are not the same thing to debug.
      allow write: if isAdmin()
                   && 'allergenReviewedBy' in request.resource.data
                   && 'authoredBy' in request.resource.data
                   && request.resource.data.allergenReviewedBy != null
                   && request.resource.data.allergenReviewedBy
                      != request.resource.data.authoredBy;
      allow delete: if isAdmin();
    }

    // The list screen reads ONE document, not a query over N.
    //
    // Firestore bills per document read. A library list that queries every
    // recipe on every tab open is N reads per open: at 200 recipes, 10,000
    // women and three opens a day that is six million reads a day, about $360 a
    // day. This project has already been bitten by that shape of cost once.
    //
    // So `meta/recipes` holds `{ version }` — one small read per session,
    // skipped while the cached version is current — and `recipeIndex/{id}` is a
    // single document holding the list row for every recipe, about 250 bytes
    // each. Both are server-written: a client that could write the index could
    // change what every other woman is offered.
    match /recipeIndex/{id} { allow read: if isVerified() || isAdmin(); allow write: if isAdmin(); }
    match /meta/{docId}     { allow read: if isVerified() || isAdmin();
                              allow write: if isAdmin()
                                           && docId != 'communityFoods'
                                           && docId != 'communityFoodsVersion'; }

    // The foods the owner approved from what women confirmed in the meal check:
    // `meta/communityFoods` holds the list and `meta/communityFoodsVersion` the
    // number phones check once a day. Verified members read them under the
    // rule above; only functions/nutrition/community_foods.py writes them, so
    // the two are carved out of the admin write above.

    // The exercise and workout content, readable before sign-in so a guest can
    // browse Train. Only these version documents and the workout library: every
    // other `meta/*` document (features, recipes) keeps the rule above. Rules
    // OR across matches, so these add a read and never remove one.
    match /meta/exerciseLibrary { allow read: if true; }
    match /meta/exercises       { allow read: if true; }
    match /meta/workouts        { allow read: if true; }

    // The owner's workouts, the same shape as the recipe library: `meta/workouts`
    // holds the version (under the rule above) and `workoutLibrary/v{N}` holds
    // every published programme in one document, so a member's phone reads one
    // small document a day and the library only when it moved. Written by the
    // console with the admin claim only.
    match /workoutLibrary/{id} { allow read: if true; allow write: if isAdmin(); }

    // The media library's register: one line per picture or clip uploaded by
    // functions/tools/upload_media.py (owner credentials, the Admin SDK). The
    // console reads it to offer a file; no client writes it, admin included,
    // so the list cannot name a file that was never uploaded.
    match /mediaLibrary/{id}   { allow read: if isAdmin(); allow write: if false; }

    // `meta/features` lives under the rule above: the switches a member's app
    // takes from the server (today only `events`). Verified women read it once
    // a launch; only an admin flips it, from Z14.

    // ---------------------------------------------------------------- events
    //
    // Feature.events. The owner creates, publishes and cancels an event from
    // the dashboard; a verified woman reads it once it is published, and never
    // before. A draft is the owner's working copy and a cancelled event is
    // simply gone from the member's list.
    //
    // Seats. `seatsTaken` and events/{id}/attendees/{uid} are written by the
    // register_for_event and cancel_event_registration callables in one
    // transaction, never by a client: not by a member, and not by the admin
    // either, so the count cannot drift from the list. An admin write may
    // create an event with no seats taken or edit one with `seatsTaken`
    // unchanged. A woman reads only her own attendee record; the admin reads
    // them all. There is no "interested" and no public attendee list.
    //
    // The member's query has to say `status == 'published'` or it is refused
    // as a whole, which is what keeps a draft from ever reaching her phone.
    match /events/{eventId} {
      function optionalText(d, key, max) {
        return !(key in d) || d[key] == null
               || (d[key] is string && d[key].size() <= max);
      }
      // The Nth name of a file list, if there is one, is a file name of the
      // right kind. Rules have no loop, so the longest allowed list is spelled
      // out: six pictures, two clips.
      function nameAt(names, i, pattern) {
        return names.size() <= i
               || (names[i] is string && names[i].matches(pattern));
      }
      function pictureNames(names) {
        return names is list && names.size() <= 6
          && nameAt(names, 0, '^[a-z0-9][a-z0-9_-]{0,80}[.](webp|jpg|jpeg)$')
          && nameAt(names, 1, '^[a-z0-9][a-z0-9_-]{0,80}[.](webp|jpg|jpeg)$')
          && nameAt(names, 2, '^[a-z0-9][a-z0-9_-]{0,80}[.](webp|jpg|jpeg)$')
          && nameAt(names, 3, '^[a-z0-9][a-z0-9_-]{0,80}[.](webp|jpg|jpeg)$')
          && nameAt(names, 4, '^[a-z0-9][a-z0-9_-]{0,80}[.](webp|jpg|jpeg)$')
          && nameAt(names, 5, '^[a-z0-9][a-z0-9_-]{0,80}[.](webp|jpg|jpeg)$');
      }
      function clipNames(names) {
        return names is list && names.size() <= 2
          && nameAt(names, 0, '^[a-z0-9][a-z0-9_-]{0,80}[.]mp4$')
          && nameAt(names, 1, '^[a-z0-9][a-z0-9_-]{0,80}[.]mp4$');
      }
      function validEvent(d) {
        return d.keys().hasOnly(['titleEn', 'titleAr', 'descriptionEn',
                                 'descriptionAr', 'startsAt', 'endsAt',
                                 'timeZone', 'mode', 'link', 'placeName',
                                 'audience', 'capacity', 'coverFile',
                                 'status', 'createdAt', 'updatedAt',
                                 'imageFiles', 'videoFiles',
                                 'locationAddress', 'locationUrl',
                                 'seatsTaken'])
          && d.keys().hasAll(['titleEn', 'titleAr', 'startsAt', 'endsAt',
                              'mode', 'audience', 'status'])
          && d.titleEn is string && d.titleEn.size() > 0 && d.titleEn.size() <= 120
          && d.titleAr is string && d.titleAr.size() > 0 && d.titleAr.size() <= 120
          && optionalText(d, 'descriptionEn', 2000)
          && optionalText(d, 'descriptionAr', 2000)
          && d.startsAt is timestamp && d.endsAt is timestamp
          && d.startsAt < d.endsAt
          && (!('timeZone' in d) || d.timeZone == 'Africa/Cairo')
          && d.status in ['draft', 'published', 'cancelled']
          && d.audience == 'all'
          && d.mode in ['online', 'place']
          && (d.mode != 'online'
              || (d.link is string && d.link.matches('^https://[^[:space:]]{3,500}$')))
          && (d.mode != 'place'
              || (d.placeName is string && d.placeName.size() > 0
                  && d.placeName.size() <= 120))
          && optionalText(d, 'link', 510)
          && optionalText(d, 'placeName', 120)
          && optionalText(d, 'locationAddress', 300)
          && (!('locationUrl' in d) || d.locationUrl == null
              || (d.locationUrl is string && d.locationUrl.size() <= 500
                  && d.locationUrl.matches('^https://((maps[.]google[.]com|maps[.]app[.]goo[.]gl)([/?#][^[:space:]]*)?|goo[.]gl/maps([/?#][^[:space:]]*)?|www[.]google[.]com/maps([/?#][^[:space:]]*)?)$')))
          && (!('capacity' in d) || d.capacity == null
              || (d.capacity is int && d.capacity > 0 && d.capacity <= 100000))
          && optionalText(d, 'coverFile', 200)
          && (!('imageFiles' in d) || pictureNames(d.imageFiles))
          && (!('videoFiles' in d) || clipNames(d.videoFiles))
          && (!('seatsTaken' in d)
              || (d.seatsTaken is int && d.seatsTaken >= 0
                  && (d.seatsTaken == 0
                      || (d.get('capacity', null) != null
                          && d.seatsTaken <= d.capacity))));
      }
      allow read: if isAdmin()
                  || (isVerified() && resource.data.status == 'published');
      allow create: if isAdmin() && validEvent(request.resource.data)
                    && request.resource.data.get('seatsTaken', 0) == 0;
      allow update: if isAdmin() && validEvent(request.resource.data)
                    && request.resource.data.get('seatsTaken', 0)
                       == resource.data.get('seatsTaken', 0);
      // Cancelling is the way to retire an event. Deleting one would leave
      // its attendee records behind, out of reach of export and deletion.
      allow delete: if false;

      // Her place on the event. Server-written only (see above).
      match /attendees/{attendeeUid} {
        allow read: if isAdmin()
                    || (signedIn() && request.auth.uid == attendeeUid);
        allow write: if false;
      }
    }

    // --------------------------------------------------------- server only
    //
    // Everything identity verification touches. Spec §5: "deny all client
    // writes to verification, consent, hash, flag, and config data."
    //
    // All of these would already be denied by the catch-all at the bottom of
    // this file. They are named anyway, for the same reason the catch-all is
    // stated explicitly rather than implied: a reader auditing this file should
    // be able to see the posture for a collection without having to reason
    // about what is absent. A deny that is visible is a deny that survives the
    // next person's edit.
    match /verificationJobs/{jobId}    { allow read, write: if false; }
    match /nidRegistry/{hash}          { allow read, write: if false; }

    // The flag queue. NOT client-readable even by an admin: spec §5's review
    // screen goes through `list_verification_flags`, an Admin-SDK callable, so
    // that opening evidence writes an access-log entry. A directly readable
    // flag collection would be a way to read the queue without leaving a trace.
    match /verification_flags/{flagId} { allow read, write: if false; }

    // Ephemeral liveness session state, spec §4 row 4: maximum one hour, no
    // images, no raw ID. The document id IS the sessionId, and it is written
    // and consumed only by the server — a client that could read it would learn
    // the challenge sequence before being asked to perform it, which is the one
    // piece of information that makes the challenge worth randomising.
    match /verificationSessions/{sessionId} { allow read, write: if false; }

    // The per-uid cost ledger (spec §6). Closed to her as well as to everyone
    // else: a client that could write it could grant itself unlimited paid
    // provider calls, and one that could read it learns our unit economics.
    match /verificationLedger/{uid}    { allow read, write: if false; }

    // The reviewer dashboard's state: vouched phone numbers, each reviewer's
    // settings and availability, and booked review slots. All of it goes
    // through Admin-SDK callables (approve_user, set_reviewer_settings,
    // book_review_slot ...), so a client can neither read who is vouched for
    // nor book itself a slot.
    match /verificationPreapproved/{phone} { allow read, write: if false; }
    match /verificationReviewers/{uid}     { allow read, write: if false; }
    match /verificationBookings/{slot}     { allow read, write: if false; }

    // Cross-account behaviour counters backing spec §3's last two FLAG signals.
    // Keyed by hash, never by device id or ID number.
    match /verificationBehaviour/{hash} { allow read, write: if false; }
    match /verificationInstalls/{hash}  { allow read, write: if false; }

    // The daily kill-switch counter (spec §6) and the evidence access log
    // (spec §5). The access log in particular must never be client-writable:
    // an audit trail an actor can edit is not an audit trail.
    match /verificationStats/{day}     { allow read, write: if false; }
    match /verificationEvidenceAccess/{entryId} { allow read, write: if false; }

    // Thresholds live here, not in Remote Config and not in the client
    // (spec §3). A client-readable threshold document tells an attacker exactly
    // how close they got.
    match /verificationConfig/{docId}  { allow read, write: if false; }

    // G15. The assistant's daily allowance. Function-only, deliberately.
    //
    // `AssistantQuota` on the device is a MIRROR so the composer can disable
    // itself; it is not the security boundary. A client that could write here
    // could grant itself unlimited questions against a metered third-party
    // model, which is the one feature in this product with an unbounded bill.
    // The caps are 5 questions per woman per day and 6 drafts per coach.
    match /assistantQuota/{uid}     { allow read, write: if false; }

    // W1. The launch waitlist: phone numbers and emails of people who are not
    // members. Written only by the join_waitlist Function; its per-IP counter
    // likewise. No client, admin included, reads or writes either.
    match /waitlist/{entryId}       { allow read, write: if false; }
    match /waitlistRate/{key}       { allow read, write: if false; }
    // M11. The proof she agreed to the waitlist wording: a keyed code of her
    // contact, the wording version, the language and the date, for three
    // years. Function-only, like the two above.
    match /waitlistConsentProof/{key} { allow read, write: if false; }
    // K07. A coach's invite codes: her uid and two dates, nothing about the
    // women she invites. Written and read only by create_coach_invite and
    // accept_coach_invite. Deletion row 49.
    match /coachInvites/{code}      { allow read, write: if false; }
    // The console's own records. adminAccessLog is the line every dashboard
    // and log read leaves (an audit trail nobody may edit, admin included);
    // opsErrors is a daily count of function error codes. Both are written
    // and read only by the admin_dashboard and admin_logs callables.
    match /adminAccessLog/{entryId} { allow read, write: if false; }
    match /opsErrors/{day}          { allow read, write: if false; }

    // STILL MISSING, and deliberately not guessed at:
    //   planDrafts, media, enquiries, payments.
    // Each is referenced by Phase 3 code, and each needs its shape settled
    // against the emulator before a rule is written for it. A rule invented
    // from inference reads as protection while protecting nothing, and none of
    // these can be tested until the Firebase project exists. Tracked as an
    // owner task.

    // --------------------------------------------------- deny by default
    // The exact-photo cache for meal scans (functions/nutrition/cache.py): the
    // model's items for one photo, keyed by its hash, with no uid and no image.
    // Server-only; a Firestore TTL policy on `expiresAt` removes old rows.
    match /scanCache/{hash} { allow read, write: if false; }

    // Foods women offered from the meal check, and the markers that stop one
    // woman confirming twice (an HMAC of her uid, never the uid). Server-only:
    // not even an admin reads them from a client; the dashboard uses the
    // list_community_foods callable.
    match /communityFoodCandidates/{key} {
      allow read, write: if false;
      match /by/{marker} { allow read, write: if false; }
    }

    // Anything not named above is denied. Stated explicitly so the posture is
    // visible rather than implied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
