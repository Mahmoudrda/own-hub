// Cloud Storage rules.
//
// This file did not exist. Firestore had rules from the start and Storage had
// none, which means every media path in this product has been running on
// whatever the console default happened to be. It is created here for the admin
// content library (DECISIONS.md D12, plan G16) and **deliberately denies
// everything else**, so the gap is now a closed door rather than an open one.
//
// # Other groups own the other paths
//
// ID and selfie capture have no path (see below). Her media (user-media/{uid})
// and coach certificates (coach-docs/{uid}) have blocks of their own (C5). New
// paths add their own `match` blocks ABOVE the catch-all. Until they do, they
// are denied, which is the correct direction to fail.
//
// # Two absences that are deliberate, and must stay
//
//   * **Progress photos have no path here at all.** G7 established they are
//     local-only with no server copy, and A02's export is narrower than the
//     words "download everything" for exactly that reason. If someone later
//     notices the "gap" and adds `users/{uid}/photos/**`, they will have moved
//     a woman's body photographs onto a server, silently, while fixing what
//     looked like an oversight. It is not an oversight.
//     ONE NAMED EXCEPTION, owner decision for private coaching: a coach's
//     application carries before-and-after photos of other women (with their
//     written consent) and screenshots of their messages. They live in
//     coach-docs/{uid}/transformations and /testimonials, and only the coach
//     and the woman reviewer can read them. The publisher is a man and the
//     admin claim is deliberately NOT given read access to those two folders.
//     Nothing else of this kind exists on the server.
//   * **ID card and selfie images have no long-lived path.** Rule 7 says they
//     are deleted once the check completes, and the cheapest way to keep that
//     promise is to give them nowhere durable to live. The verification
//     provider holds them for the duration of the check and destroys them; that
//     flow runs server-side and does not write here.
//
// # Nothing here is world-readable
//
// This is a women-only product. Read requires a signed-in account everywhere,
// including the exercise videos — a public bucket URL would be a way into the
// library from outside the gate.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Server-set custom claim, exactly as token.verified and token.coachV are.
    // A client cannot grant itself admin.
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The dormant features, off here as in firestore.rules (APL-16). With a
    // switch false a verified account calling the API directly is refused.
    // Deleting her own file stays open. The coach portfolio paths (coach-docs,
    // coach-public) follow coachPortfolioLive(), payment-proofs follows
    // coachPaymentsLive(), and each moves with the functions of the same name
    // in firestore.rules, in the same release.
    function communityLive() {
      return false;
    }

    function coachPortfolioLive() {
      return true;
    }

    function coachPaymentsLive() {
      return false;
    }

    // ------------------------------------------------ the content library
    //
    // Exercise demonstrations, recipe photographs, programme artwork. Uploaded
    // in bulk from Z10.
    //
    // Exercise demonstrations are public so a signed-out visitor can browse
    // Train. Nothing else under content/ is: this is the only open path.
    match /content/exercises/{docId}/{file} {
      allow read: if true;
      allow write: if isAdmin()
                   && (isImage() || isVideo())
                   && request.resource.size < 200 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Event pictures and clips, written from the dashboard's Events tab and
    // read by verified members (events are a verified-only surface). A picture
    // is webp or jpeg up to 1 MiB, a clip is mp4 up to 10 MiB.
    match /content/events/{eventId}/{file} {
      allow read: if signedIn()
                  && (request.auth.token.get('verified', false) == true || isAdmin());
      allow write: if isAdmin()
                   && ((request.resource.contentType in ['image/webp', 'image/jpeg']
                        && request.resource.size <= 1024 * 1024)
                       || (request.resource.contentType == 'video/mp4'
                           && request.resource.size <= 10 * 1024 * 1024));
      allow delete: if isAdmin();
    }

    // Every other content path is read by every signed-in member.
    //
    // The size ceiling is a guard against an accidental upload of the wrong
    // file, not a quality setting: these are short demonstration clips, and a
    // 200 MB video would be unwatchable on Egyptian mobile data long before it
    // was a storage problem.
    //
    // Events are carved out: matches combine, so without `!= 'events'` this
    // block would let any signed-in account read event media and let the
    // admin write past the event limits.
    match /content/{collection}/{docId}/{file} {
      allow read: if signedIn() && collection != 'events';
      allow write: if isAdmin()
                   && collection != 'events'
                   && (isImage() || isVideo())
                   && request.resource.size < 200 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ------------------------------------------------- her own data export
    //
    // A02's "Download my data" writes here from a Cloud Function and she reads
    // it back. Function-written only: a client that could write its own export
    // could put any file behind a link the app presents as her own data.
    //
    // Deletion manifest row 25 deletes this prefix. Objects also expire after
    // 24 hours, so an export left on a shared device stops working by itself.
    match /user-exports/{uid}/{allPaths=**} {
      allow read:  if isOwner(uid);
      allow write: if false;
    }

    // --------------------------------------------------------- her media
    //
    // C5. G7 §1.3's one prefix for a woman's own media: post photos, her
    // profile photo, coach portfolio media, message attachments and voice
    // notes. Deleted with her account in both buckets, and again by the late
    // sweep (functions/account/deletion.py STORAGE_PREFIXES).
    //
    // READ IS OWNER-ONLY. That is the most private option the app supports
    // today: no screen downloads another woman's file yet, and the app has no
    // sub-path that says which file is a public post photo and which is a
    // voice note to one coach. When the feed, a coach page or a chat starts
    // showing her media to someone else, that feature adds a narrow read for
    // its own sub-path here; until then nobody but her can open anything.
    //
    // Writing is hers alone and needs the verified claim, like every
    // community write in Firestore. An image up to 10 MB or audio up to 5 MB;
    // nothing else (no video, no documents, no unknown type). Deleting stays
    // open to her without the claim: taking her own photo down must not
    // depend on a claim she might lose (the same exception as posts).
    match /user-media/{uid}/{allPaths=**} {
      allow read:   if isOwner(uid);
      allow create, update: if communityLive()
                    && isOwner(uid)
                    && request.auth.token.get('verified', false) == true
                    && ((isImage() && request.resource.size < 10 * 1024 * 1024)
                        || (isAudio() && request.resource.size < 5 * 1024 * 1024));
      allow delete: if isOwner(uid);
    }

    // ------------------------------------------------ coach application files
    //
    // A coach's application files, under coach-docs/{coachUid}/{folder}/{file}.
    // Six folders and no others (gallery holds portfolio photos). Written by her while the coach service is
    // live and her account is verified: an image up to 10 MB (jpeg, png or
    // webp), or a PDF for education and certificates only.
    //
    // Who reads what. Her profile photo, education and certificates: she, the
    // admin and a woman reviewer. Testimonials and before-and-after photos
    // show other women (with consent) and their private messages: she and a
    // woman reviewer ONLY, never the admin claim. See the named exception in
    // the header. Deleting her own file stays open to her.
    function isWomanReviewer() {
      return signedIn() && request.auth.token.get('womanReviewer', false) == true;
    }

    function isFinance() {
      return signedIn() && request.auth.token.get('finance', false) == true;
    }

    function isCoachImage() {
      return request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    match /coach-docs/{uid}/{folder}/{file} {
      allow read: if coachPortfolioLive()
                  && isOwner(uid)
                  && folder in ['photo', 'education', 'certificates',
                                'testimonials', 'transformations', 'gallery'];
      allow read: if coachPortfolioLive()
                  && (isAdmin() || isWomanReviewer())
                  && folder in ['photo', 'education', 'certificates'];
      allow read: if coachPortfolioLive()
                  && isWomanReviewer()
                  && folder in ['testimonials', 'transformations', 'gallery'];
      allow create, update: if coachPortfolioLive()
                    && isOwner(uid)
                    && request.auth.token.get('verified', false) == true
                    && folder in ['photo', 'education', 'certificates',
                                  'testimonials', 'transformations', 'gallery']
                    && (isCoachImage()
                        || (isPdf() && folder in ['education', 'certificates']))
                    && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    // What the public coach page shows (her photo, checked and resized by the
    // service). Verified members read it; only the service writes it.
    match /coach-public/{uid}/{file} {
      allow read: if coachPortfolioLive()
                  && request.auth != null
                  && request.auth.token.get('verified', false) == true;
      allow write: if false;
    }

    // Approved portfolio photos, re-encoded by the service. Verified members
    // read; nothing writes from a client.
    match /coach-public/{uid}/media/{file} {
      allow read: if coachPortfolioLive()
                  && request.auth != null
                  && request.auth.token.get('verified', false) == true;
      allow write: if false;
    }

    // A member's screenshot of her transfer. The service writes it and deletes
    // it after the decision; staff with the finance claim, or the admin, read it.
    match /payment-proofs/{uid}/{file} {
      allow read: if coachPaymentsLive() && (isAdmin() || isFinance());
      allow write: if false;
    }

    // ------------------------------------------------------------- default
    //
    // Everything not named above is denied, for everyone, in both directions.
    // New media paths are added as explicit blocks above this one.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
