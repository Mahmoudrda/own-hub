// Cloud Storage rules.
//
// This file did not exist. Firestore had rules from the start and Storage had
// none, which means every media path in this product has been running on
// whatever the console default happened to be. It is created here for the admin
// content library (DECISIONS.md D12, plan G16) and **deliberately denies
// everything else**, so the gap is now a closed door rather than an open one.
//
// # Other groups own the other paths
//
// ID and selfie capture have no path (see below). Her media (user-media/{uid})
// and coach certificates (coach-docs/{uid}) have blocks of their own (C5). New
// paths add their own `match` blocks ABOVE the catch-all. Until they do, they
// are denied, which is the correct direction to fail.
//
// # Two absences that are deliberate, and must stay
//
//   * **Progress photos have no path here at all.** G7 established they are
//     local-only with no server copy, and A02's export is narrower than the
//     words "download everything" for exactly that reason. If someone later
//     notices the "gap" and adds `users/{uid}/photos/**`, they will have moved
//     a woman's body photographs onto a server, silently, while fixing what
//     looked like an oversight. It is not an oversight.
//   * **ID card and selfie images have no long-lived path.** Rule 7 says they
//     are deleted once the check completes, and the cheapest way to keep that
//     promise is to give them nowhere durable to live. The verification
//     provider holds them for the duration of the check and destroys them; that
//     flow runs server-side and does not write here.
//
// # Nothing here is world-readable
//
// This is a women-only product. Read requires a signed-in account everywhere,
// including the exercise videos — a public bucket URL would be a way into the
// library from outside the gate.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Server-set custom claim, exactly as token.verified and token.coachV are.
    // A client cannot grant itself admin.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------ the content library
    //
    // Exercise demonstrations, recipe photographs, programme artwork. Uploaded
    // in bulk from Z10, read by every signed-in member.
    //
    // The size ceiling is a guard against an accidental upload of the wrong
    // file, not a quality setting: these are short demonstration clips, and a
    // 200 MB video would be unwatchable on Egyptian mobile data long before it
    // was a storage problem.
    match /content/{collection}/{docId}/{file} {
      allow read: if signedIn();
      allow write: if isAdmin()
                   && (isImage() || isVideo())
                   && request.resource.size < 200 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // ------------------------------------------------- her own data export
    //
    // A02's "Download my data" writes here from a Cloud Function and she reads
    // it back. Function-written only: a client that could write its own export
    // could put any file behind a link the app presents as her own data.
    //
    // Deletion manifest row 25 deletes this prefix. Objects also expire after
    // 24 hours, so an export left on a shared device stops working by itself.
    match /user-exports/{uid}/{allPaths=**} {
      allow read:  if isOwner(uid);
      allow write: if false;
    }

    // --------------------------------------------------------- her media
    //
    // C5. G7 §1.3's one prefix for a woman's own media: post photos, her
    // profile photo, coach portfolio media, message attachments and voice
    // notes. Deleted with her account in both buckets, and again by the late
    // sweep (functions/account/deletion.py STORAGE_PREFIXES).
    //
    // READ IS OWNER-ONLY. That is the most private option the app supports
    // today: no screen downloads another woman's file yet, and the app has no
    // sub-path that says which file is a public post photo and which is a
    // voice note to one coach. When the feed, a coach page or a chat starts
    // showing her media to someone else, that feature adds a narrow read for
    // its own sub-path here; until then nobody but her can open anything.
    //
    // Writing is hers alone and needs the verified claim, like every
    // community write in Firestore. An image up to 10 MB or audio up to 5 MB;
    // nothing else (no video, no documents, no unknown type). Deleting stays
    // open to her without the claim: taking her own photo down must not
    // depend on a claim she might lose (the same exception as posts).
    match /user-media/{uid}/{allPaths=**} {
      allow read:   if isOwner(uid);
      allow create, update: if isOwner(uid)
                    && request.auth.token.get('verified', false) == true
                    && ((isImage() && request.resource.size < 10 * 1024 * 1024)
                        || (isAudio() && request.resource.size < 5 * 1024 * 1024));
      allow delete: if isOwner(uid);
    }

    // ------------------------------------------------ coach certificates
    //
    // C5. K02: a coach's certificate scans, under coach-docs/{coachUid}/
    // (coach_credentials.dart builds exactly this path). A PDF or an image up
    // to 10 MB, written by her. Read by her and by an admin reviewing the
    // credential; never by clients or other coaches.
    match /coach-docs/{uid}/{allPaths=**} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
                    && request.auth.token.get('verified', false) == true
                    && (isImage() || isPdf())
                    && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isOwner(uid);
    }

    // ------------------------------------------------------------- default
    //
    // Everything not named above is denied, for everyone, in both directions.
    // New media paths are added as explicit blocks above this one.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
