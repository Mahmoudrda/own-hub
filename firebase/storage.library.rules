// Cloud Storage rules for the default bucket (own-hub.firebasestorage.app).
//
// That bucket is in US-EAST1 and holds only the admin content library. Her own
// media, coach certificates and exports live in own-hub-personal (Frankfurt),
// which gets firebase/storage.rules. No personal path exists here, so nothing
// about her can land in the United States even when community or coaching is
// switched on later.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    // Exercise demonstrations are public so a signed-out visitor can browse
    // Train. Nothing else under content/ is: this is the only open path.
    match /content/exercises/{docId}/{file} {
      allow read: if true;
      allow write: if isAdmin()
                   && (isImage() || isVideo())
                   && request.resource.size < 200 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    // Event pictures and clips, written from the dashboard's Events tab and
    // read by verified members. A picture is webp or jpeg up to 1 MiB, a clip
    // is mp4 up to 10 MiB.
    match /content/events/{eventId}/{file} {
      allow read: if signedIn()
                  && (request.auth.token.get('verified', false) == true || isAdmin());
      allow write: if isAdmin()
                   && ((request.resource.contentType in ['image/webp', 'image/jpeg']
                        && request.resource.size <= 1024 * 1024)
                       || (request.resource.contentType == 'video/mp4'
                           && request.resource.size <= 10 * 1024 * 1024));
      allow delete: if isAdmin();
    }

    // Matches combine, so events are carved out of this block: without
    // `!= 'events'` any signed-in account could read event media and the admin
    // could write past the event limits.
    match /content/{collection}/{docId}/{file} {
      allow read: if signedIn() && collection != 'events';
      allow write: if isAdmin()
                   && collection != 'events'
                   && (isImage() || isVideo())
                   && request.resource.size < 200 * 1024 * 1024;
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
